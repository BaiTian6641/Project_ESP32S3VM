diff --git a/tests/qtest/esp32s3-i2c-test.c b/tests/qtest/esp32s3-i2c-test.c
--- a/tests/qtest/esp32s3-i2c-test.c
+++ b/tests/qtest/esp32s3-i2c-test.c
@@ -1324,6 +1324,46 @@
 static void test_filter_unknown_dc(void) { filter_unknown_persistence(false); }
 static void test_filter_unknown_rc(void) { filter_unknown_persistence(true); }
 
+static void test_filter_partial_valid_reversal(void)
+{
+    for (unsigned rc = 0; rc < 2; rc++) {
+        filter_unknown_setup(rc);
+        /* The valid SDA HIGH is not a bit while SCL is indeterminate, but
+         * it must cancel the earlier LOW candidate and its old timestamp. */
+        filter_peer_level(10, true);
+        ticks(20000);
+        g_assert_true(physical_pad_level(8, "high"));
+        g_assert_true(physical_pad_level(12, "indeterminate"));
+        filter_peer_level(13, false);
+        g_assert_cmphex(rd(0x20) & (DET_START_INT | COMPLETE), ==, 0);
+
+        /* A distinct LOW has not met 200 ns persistence when SCL returns. */
+        filter_peer_level(10, false);
+        ticks(100);
+        g_assert_true(physical_pad_level(8, "low"));
+        qtest_writel(s, GPIO(GPIO_FUNC_IN_SEL_CFG_OFFSET(89)), BIT(7) | 9);
+        filter_peer_level(13, true);
+        g_assert_true(physical_pad_level(9, "high"));
+        g_assert_cmphex(rd(0x20) & (DET_START_INT | COMPLETE), ==, 0);
+        ticks(50);
+        g_assert_cmphex(rd(0x20) & (DET_START_INT | COMPLETE), ==, 0);
+
+        /* Genuine persistence subsequently starts a real byte transaction. */
+        ticks(200);
+        g_assert_cmphex(rd(0x20) & DET_START_INT, ==, DET_START_INT);
+        filter_peer_byte(0x84);
+        filter_peer_byte(0x5a);
+        filter_peer_level(10, false); ticks(10000);
+        filter_peer_level(11, true); ticks(10000);
+        filter_peer_level(10, true); ticks(10000);
+        g_assert_cmphex(rd(0x20) & (COMPLETE | BIT(13) | MAIN_ST_TO_INT | BIT(2)), ==, COMPLETE);
+        g_assert_cmphex((rd(8) >> 8) & 63, ==, 1);
+        g_assert_cmphex(rd(0x1c), ==, 0x5a);
+        g_assert_cmphex((rd(8) >> 8) & 63, ==, 0);
+        qtest_quit(s);
+    }
+}
+
 
 int main(int argc, char **argv)
 {
@@ -1365,5 +1405,6 @@
     qtest_add_func("/esp32s3/i2c/service-simultaneous-high-does-not-commit", test_service_simultaneous_high_not_stop);
     qtest_add_func("/esp32s3/i2c/filter-unknown-powered-dc-matrix", test_filter_unknown_dc);
     qtest_add_func("/esp32s3/i2c/filter-unknown-powered-rc-matrix", test_filter_unknown_rc);
+    qtest_add_func("/esp32s3/i2c/filter-partial-valid-reversal", test_filter_partial_valid_reversal);
     return g_test_run();
 }
