+static void native_wire(unsigned fault)
+{
+    for (unsigned ten = 0; ten < 2; ten++) {
+    for (unsigned master = 0; master < 2; master++) {
+        setup(fault, master);
+        bus = 1 - master;
+        wr(4, BIT(13) | 3);
+        wr(0x10, ten ? BIT(31) | (0xa2 << 7) | 0x79 : 0x42);
+        wr(0x50, 0);
+        wr(0x1c, 0x12); wr(0x1c, 0x34);
+        bus = master;
+        const uint8_t seven[] = {0x84, 0x5a, 0xc3, 0x85};
+        const uint8_t tenbit[] = {0xf2, 0xa2, 0x5a, 0xc3, 0xf3};
+        tx(ten ? tenbit : seven, ten ? sizeof(tenbit) : sizeof(seven));
+        command(0, START); command(1, WRITE(ten ? 4 : 3));
+        command(2, START); command(3, WRITE(1));
+        command(4, READ(1)); command(5, LAST(1)); command(6, STOP);
+        launch(); complete();
+        g_assert_cmphex(rd(0x1c), ==, 0x12);
+        g_assert_cmphex(rd(0x1c), ==, 0x34);
+        bus = 1 - master;
+        g_assert_cmphex(rd(0x1c), ==, 0x5a);
+        g_assert_cmphex(rd(0x1c), ==, 0xc3);
+        g_assert_cmphex(rd(0x20) & COMPLETE, ==, COMPLETE);
+        qtest_quit(s);
+    }
+    }
+}
+static void test_native_wire(void) { native_wire(9); }
+static void test_native_wire_rc(void) { native_wire(10); }
