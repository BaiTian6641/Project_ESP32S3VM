+static void test_data_arbitration(void)
+{
+    for (unsigned unequal = 0; unequal < 2; unequal++) {
+    for (unsigned refill = 0; refill < 2; refill++) {
+    for (unsigned winner = 0; winner < 2; winner++) {
+        setup(9, winner);
+        if (unequal) {
+            bus = 1; wr(0, 49); wr(0x38, 50);
+        }
+        for (bus = 0; bus < 2; bus++) {
+            uint8_t data[32] = {0xa0, 0x80};
+            memset(data + 2, 0x11, 30);
+            if (!refill) data[2] = bus == winner ? 0x55 : 0xaa;
+            clean(); tx(data, refill ? 32 : 3);
+            command(0, START); command(1, WRITE(refill ? 32 : 3));
+            command(2, refill ? FINISH : STOP);
+            wr(4, BIT(9) | BIT(4) | 3);
+        }
+        bus = 0; wr(4, BIT(9) | BIT(4) | BIT(5) | 3);
+        bus = 1; wr(4, BIT(9) | BIT(4) | BIT(5) | 3);
+        if (refill) {
+            ticks(4000000);
+            for (bus = 0; bus < 2; bus++) {
+                g_assert_cmphex(rd(0x20) & (END | BIT(5) | COMPLETE | NACK), ==, END);
+                wr(0x1c, bus == winner ? 0x55 : 0xaa);
+                command(0, WRITE(1)); command(1, STOP); wr(0x24, 0x7ffff);
+            }
+            bus = 0; wr(4, BIT(9) | BIT(4) | BIT(5) | 3);
+            bus = 1; wr(4, BIT(9) | BIT(4) | BIT(5) | 3);
+        }
+        ticks(2000000);
+        bus = 1 - winner;
+        g_assert_cmphex(rd(0x20) & (BIT(5) | COMPLETE), ==, BIT(5));
+        bus = winner;
+        g_assert_cmphex(rd(0x20) & (BIT(5) | COMPLETE | NACK), ==, COMPLETE);
+        ticks(6000000);
+        clean();
+        uint8_t address[] = {0xa0, refill ? 0x8e : 0x80, 0xa1};
+        tx(address, sizeof(address));
+        command(0, START); command(1, WRITE(2)); command(2, START);
+        command(3, WRITE(1)); command(4, LAST(1)); command(5, STOP);
+        launch(); complete();
+        g_assert_cmphex(rd(0x1c), ==, 0x55);
+        /* A losing controller replays freshly after bus idle. */
+        bus = 1 - winner; clean();
+        tx(address, sizeof(address));
+        command(0, START); command(1, WRITE(2)); command(2, START);
+        command(3, WRITE(1)); command(4, LAST(1)); command(5, STOP);
+        launch(); complete(); g_assert_cmphex(rd(0x1c), ==, 0x55);
+        qtest_quit(s);
+    }
+    }
+    }
