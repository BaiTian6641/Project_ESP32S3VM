+    script_graph("{\"bit_ns\":10000,\"transactions\":[{\"address\":0,\"read\":true,\"count\":1}]}", false, false);
+    ticks(3000000);
+    g_assert_cmphex(rd(0x20) & (GENERAL_CALL_INT | COMPLETE), ==, 0);
+    g_assert_cmphex(rd(8) & BIT(5), ==, 0);
+    g_assert_cmphex((rd(8) >> 18) & 63, ==, 1);
+    g_assert_cmphex((rd(8) >> 8) & 63, ==, 0);
