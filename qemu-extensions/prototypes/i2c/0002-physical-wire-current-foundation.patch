+static void test_stop_rc_clock_interference(void)
+{
+    setup(10, 0);
+    bus = 1; wr(4, 3); wr(0x10, 0x42); wr(0x50, 0);
+    qtest_writel(s, PAD(12), INPUT & ~R_IO_MUX_GPIOn_FUN_IE_MASK);
+    qtest_writel(s, GPIO(GPIO_PINn_REG_OFFSET(12)), R_GPIO_PINn_PAD_DRIVER_MASK);
+    qtest_writel(s, GPIO(GPIO_FUNC_OUT_SEL_CFG_OFFSET(12)), GPIO_FUNC_OUT_SEL_NONE);
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TS), BIT(12));
+    qtest_writel(s, GPIO(A_GPIO_ENABLE_W1TS), BIT(12));
+    bus = 0; clean(); tx((uint8_t[]){0x84, 0x55}, 2);
+    command(0, START); command(1, WRITE(2)); command(2, FINISH);
+    launch(); ticks(2000000);
+    g_assert_cmphex(rd(0x20) & (END | TIMEOUT | NACK), ==, END);
+    command(0, STOP); wr(0x24, 0x7ffff); launch();
+    bool scl_high = false;
+    for (unsigned i = 0; i < 100; i++) {
+        ticks(100);
+        if (physical_pad_level(9, "high")) {
+            scl_high = true;
+            break;
+        }
+    }
+    g_assert_true(scl_high);
+    bool sda_transition = false;
+    for (unsigned i = 0; i < 200; i++) {
+        ticks(100);
+        if (physical_pad_level(8, "indeterminate")) {
+            sda_transition = true;
+            break;
+        }
+    }
+    g_assert_true(sda_transition);
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TC), BIT(12));
+    ticks(10000);
+    g_assert_true(physical_pad_level(8, "high"));
+    g_assert_true(physical_pad_level(9, "low"));
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TS), BIT(12));
+    ticks(10000);
+    g_assert_cmphex(rd(0x20) & COMPLETE, ==, 0);
+    ticks(4000000);
+    g_assert_cmphex(rd(0x20) & (COMPLETE | TIMEOUT), ==, TIMEOUT);
+    qtest_quit(s);
+}
+
+static void test_service_simultaneous_high_not_stop(void)
+{
+    setup(9, 0); bus = 0;
+    for (unsigned pad = 10; pad <= 11; pad++) {
+        qtest_writel(s, GPIO(GPIO_FUNC_OUT_SEL_CFG_OFFSET(pad)), GPIO_FUNC_OUT_SEL_NONE);
+    }
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TS), BIT(10) | BIT(11));
+    qtest_writel(s, GPIO(A_GPIO_ENABLE_W1TS), BIT(10) | BIT(11));
+    uint8_t bytes[18] = {0xa0, 0x90};
+    for (unsigned i = 0; i < 16; i++) bytes[2 + i] = 0x37 + i;
+    clean(); tx(bytes, sizeof(bytes));
+    command(0, START); command(1, WRITE(sizeof(bytes))); command(2, FINISH);
+    launch(); ticks(2000000);
+    g_assert_cmphex(rd(0x20) & (END | COMPLETE | NACK | TIMEOUT), ==, END);
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TC), BIT(10) | BIT(11));
+    wr(4, BIT(10) | BIT(4) | 3);
+    /* One actual GPIO update raises both lines from LOW together.
+     * There was no SDA rising edge with SCL already HIGH. */
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TS), BIT(10) | BIT(11));
+    ticks(6000000);
+    clean(); wr(0x1c, 0xa1);
+    command(0, START); command(1, WRITE(1)); command(2, LAST(1));
+    command(3, FINISH); launch(); ticks(2000000);
+    g_assert_cmphex(rd(0x20) & (END | NACK | TIMEOUT), ==, END);
+    /* The physical EEPROM pointer wrapped back to0x90. Only a real
+     * STOP can commit its staged page, so current committed data is erased. */
+    g_assert_cmphex(rd(0x1c), ==, 0xff);
+    command(0, STOP); wr(0x24, 0x7ffff); launch(); complete();
+    ticks(6000000);
+    pointer(0x90); read_eeprom(1, true); complete();
+    g_assert_cmphex(rd(0x1c), ==, 0x37);
+    qtest_quit(s);
+}
