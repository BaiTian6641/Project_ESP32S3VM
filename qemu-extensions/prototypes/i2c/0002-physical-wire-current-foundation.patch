+static bool physical_pad_level(unsigned pad, const char *level)
+{
+    QDict *reply = qtest_qmp(s, "{'execute':'qom-get','arguments':{'path':'/machine/soc/electrical','property':'snapshot-json'}}");
+    QObject *snapshot = qobject_from_json(qdict_get_str(reply, "return"), &error_abort);
+    const QListEntry *entry;
+    bool found = false;
+    QLIST_FOREACH_ENTRY(qdict_get_qlist(qobject_to(QDict, snapshot), "physical_pads"), entry) {
+        QDict *p = qobject_to(QDict, qlist_entry_obj(entry));
+        if (qdict_get_int(p, "gpio") == pad) {
+            found = !strcmp(qdict_get_str(p, "diagnostic"), level);
+            break;
+        }
+    }
+    qobject_unref(snapshot); qobject_unref(reply);
+    return found;
+}
