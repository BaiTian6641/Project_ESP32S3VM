+static void filter_peer_level(unsigned pad, bool high)
+{
+    qtest_writel(s, GPIO(high ? A_GPIO_OUT_W1TS : A_GPIO_OUT_W1TC), BIT(pad));
+}
+
+static void filter_peer_byte(uint8_t byte)
+{
+    for (unsigned bit = 0; bit < 8; bit++) {
+        filter_peer_level(11, false); ticks(10000);
+        filter_peer_level(10, !!(byte & (0x80 >> bit))); ticks(10000);
+        filter_peer_level(11, true); ticks(10000);
+    }
+    filter_peer_level(11, false); ticks(10000);
+    filter_peer_level(10, true); ticks(10000);
+    filter_peer_level(11, true); ticks(10000);
+    g_assert_true(physical_pad_level(8, "low"));
+    filter_peer_level(11, false); ticks(10000);
+}
+
+static void filter_unknown_setup(bool rc)
+{
+    peer_boot(0x42, false, true);
+    for (unsigned pad = 10; pad <= 13; pad++) {
+        if (pad == 12) {
+            continue;
+        }
+        qtest_writel(s, PAD(pad), INPUT);
+        qtest_writel(s, GPIO(GPIO_PINn_REG_OFFSET(pad)), R_GPIO_PINn_PAD_DRIVER_MASK);
+        qtest_writel(s, GPIO(GPIO_FUNC_OUT_SEL_CFG_OFFSET(pad)), GPIO_FUNC_OUT_SEL_NONE);
+    }
+    /* Supported same-pad SCL route: IE + native signal89 output + real OD
+     * peripheral OE. Released output leaves the powered divider UNKNOWN.
+     * Never read raw GPIO inputs; strict UNKNOWN remains enabled. */
+    qtest_writel(s, PAD(12), INPUT);
+    qtest_writel(s, GPIO(GPIO_PINn_REG_OFFSET(12)), R_GPIO_PINn_PAD_DRIVER_MASK);
+    qtest_writel(s, GPIO(GPIO_FUNC_OUT_SEL_CFG_OFFSET(12)), 89);
+    qtest_writel(s, GPIO(A_GPIO_OUT_W1TS), BIT(10) | BIT(11) | BIT(13));
+    qtest_writel(s, GPIO(A_GPIO_ENABLE_W1TS), BIT(10) | BIT(11) | BIT(13));
+    filter_unknown_graph(rc);
+    g_assert_true(physical_pad_level(8, "high"));
+    g_assert_true(physical_pad_level(9, "high"));
+    g_assert_true(physical_pad_level(12, "indeterminate"));
+    g_assert_true(physical_pad_level(13, "high"));
+    /* Separate 200 ns SDA and 800 ns SCL persistence at the real 10 MHz
+     * module clock. The SDA candidate expires while routed SCL is UNKNOWN. */
+    wr(0x50, BIT(8) | BIT(9) | 8 | (2 << 4));
+    filter_peer_level(10, false);
+    ticks(100);
+    g_assert_true(physical_pad_level(8, "low"));
+    qtest_writel(s, GPIO(GPIO_FUNC_IN_SEL_CFG_OFFSET(89)), BIT(7) | 12);
+    g_assert_true(physical_pad_level(12, "indeterminate"));
+    ticks(1000);
+    g_assert_cmphex(rd(0x20) & (DET_START_INT | COMPLETE), ==, 0);
+    g_assert_cmphex((rd(8) >> 8) & 63, ==, 0);
+}
+
+static void filter_unknown_persistence(bool rc)
+{
+    /* Bounded expiry; only actual GPIO13 publication resumes the candidate. */
+    filter_unknown_setup(rc);
+    qtest_writel(s, GPIO(GPIO_FUNC_IN_SEL_CFG_OFFSET(89)), BIT(7) | 9);
+    filter_peer_level(13, false);
+    g_assert_true(physical_pad_level(13, "low"));
+    g_assert_true(physical_pad_level(8, "low"));
+    g_assert_true(physical_pad_level(9, "high"));
+    ticks(1000);
+    g_assert_cmphex(rd(0x20) & DET_START_INT, ==, DET_START_INT);
+    g_assert_cmphex(rd(0x20) & COMPLETE, ==, 0);
+    filter_peer_byte(0x84);
+    filter_peer_byte(0x5a);
+    filter_peer_level(10, false); ticks(10000);
+    filter_peer_level(11, true); ticks(10000);
+    filter_peer_level(10, true); ticks(10000);
+    g_assert_true(physical_pad_level(8, "high"));
+    g_assert_true(physical_pad_level(9, "high"));
+    g_assert_cmphex(rd(0x20) & (COMPLETE | BIT(13) | MAIN_ST_TO_INT | BIT(2)), ==, COMPLETE);
+    g_assert_cmphex((rd(8) >> 8) & 63, ==, 1);
+    g_assert_cmphex((rd(0x14) >> 22) & 0xff, ==, 1);
+    g_assert_cmphex(rd(0x1c), ==, 0x5a);
+    g_assert_cmphex((rd(8) >> 8) & 63, ==, 0);
+    qtest_quit(s);
+}
+
+static void test_filter_unknown_dc(void) { filter_unknown_persistence(false); }
+static void test_filter_unknown_rc(void) { filter_unknown_persistence(true); }
