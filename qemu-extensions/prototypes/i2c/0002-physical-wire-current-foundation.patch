+/* A powered divider is deliberately indeterminate, not an invented GPIO
+ * input bit. The slave sees it only through its real SCL matrix route. */
+static void filter_unknown_graph(bool rc)
+{
+    QObject *o = qobject_from_json("{\"version\":3,\"id\":\"filter-unknown\",\"name\":\"Filter unknown\","
+        "\"profile\":{\"chip\":\"esp32s3\",\"board\":\"esp32-s3-devkitc-1\",\"module\":\"esp32-s3-wroom-1\"},"
+        "\"firmware\":{},\"runtime\":{\"electrical\":{\"driver_profile\":\"s3-explicit-finite-v1\",\"mode\":\"dc\"}},"
+        "\"geometry\":{\"components\":{},\"nets\":{}},\"components\":[],\"nets\":[]}", &error_abort);
+    QDict *p = qobject_to(QDict, o), *c = component(p, "U", "mcu");
+    if (rc) {
+        QDict *e = qdict_get_qdict(qdict_get_qdict(p, "runtime"), "electrical");
+        qdict_put_str(e, "mode", "rc");
+        qdict_put_str(e, "edit_charge", "reset");
+    }
+    terminal(c, "vdd", "power", "input", -1);
+    terminal(c, "gnd", "ground", "input", -1);
+    for (unsigned pad = 8; pad <= 13; pad++) {
+        char role[16]; snprintf(role, sizeof(role), "io%u", pad);
+        terminal(c, role, "digital", "inout", pad);
+    }
+    c = component(p, "G", "ground");
+    terminal(c, "ref", "ground", "unspecified", -1);
+    c = component(p, "V", "voltage-source");
+    terminal(c, "p", "power", "unspecified", -1);
+    terminal(c, "n", "ground", "unspecified", -1);
+    quantity(c, "voltage", 3.3, "V");
+    net(p, "vdd", "V.p", "U.vdd");
+    net(p, "gnd", "G.ref", "V.n");
+    net(p, "gnd", "U.gnd", NULL);
+    net(p, "sda", "U.io8", "U.io10");
+    net(p, "scl", "U.io9", "U.io11");
+    net(p, "mid", "U.io12", NULL);
+    net(p, "publication", "U.io13", NULL);
+    for (unsigned i = 0; i < 5; i++) {
+        char id[16], a[20], b[20];
+        snprintf(id, sizeof(id), "R%u", i);
+        c = component(p, id, "resistor");
+        terminal(c, "a", "passive", "unspecified", -1);
+        terminal(c, "b", "passive", "unspecified", -1);
+        quantity(c, "resistance", 4700, "ohm");
+        snprintf(a, sizeof(a), "%s.a", id);
+        snprintf(b, sizeof(b), "%s.b", id);
+        net(p, i == 3 ? "gnd" : "vdd", a, NULL);
+        net(p, i == 0 ? "sda" : i == 1 ? "scl" : i == 4 ? "publication" : "mid", b, NULL);
+    }
+    if (rc) {
+        for (unsigned i = 0; i < 2; i++) {
+            char id[16], a[20], b[20];
+            snprintf(id, sizeof(id), "C%u", i);
+            c = component(p, id, "capacitor");
+            terminal(c, "p", "passive", "unspecified", -1);
+            terminal(c, "n", "passive", "unspecified", -1);
+            quantity(c, "capacitance", 1, "nF");
+            quantity(c, "initial_voltage", 0, "V");
+            snprintf(a, sizeof(a), "%s.p", id);
+            snprintf(b, sizeof(b), "%s.n", id);
+            net(p, i ? "scl" : "sda", a, NULL);
+            net(p, "gnd", b, NULL);
+        }
+    }
+    GString *json = qobject_to_json(o);
+    qtest_qmp_assert_success(s, "{'execute':'qom-set','arguments':{'path':'/machine/soc/electrical','property':'project-json','value':%s}}", json->str);
+    g_string_free(json, true); qobject_unref(o);
+    qtest_qmp_assert_success(s, "{'execute':'cont'}");
+    ticks(100000);
+}
