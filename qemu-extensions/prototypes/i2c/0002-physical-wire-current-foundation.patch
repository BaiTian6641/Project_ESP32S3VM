+static void test_stop_clock_hold_order(void)
+{
+    setup(9, 0); bus = 0;
+    qtest_writel(s, GPIO(GPIO_FUNC_OUT_SEL_CFG_OFFSET(11)), GPIO_FUNC_OUT_SEL_NONE);
