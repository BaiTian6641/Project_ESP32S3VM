+/*
+ * Peripheral handshake hooks: PERI_SEL register semantics. Values 10..63
+ * are invalid on ESP32-S3 (TRM table 3.4-1) and reserved bits read zero.
+ * Memory-to-memory transfers are independent of PERI_SEL.
+ */
+static void test_peri_sel_register(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    /* PERI_SEL is a 6-bit field, reserved bits read as zero */
+    wr(qts, CH_OUT_REG(0, REG_PERI_SEL), 0x1234u);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_PERI_SEL)), ==, 0x34);
+    wr(qts, CH_OUT_REG(0, REG_PERI_SEL), 0x3Fu); /* disconnect value */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_PERI_SEL)), ==, 0x3F);
+    wr(qts, CH_OUT_REG(0, REG_PERI_SEL), 0x9u);  /* RMT, highest valid */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_PERI_SEL)), ==, 0x9);
+
+    /* M2M works regardless of the peripheral selection */
+    build_fixture(qts, src, false, false, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, !=, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * LINK register semantics: PARK reset value 1 (both directions), INLINK
+ * AUTO_RET resets to 1, START arms a peripheral chain (PARK reads 0 until
+ * the chain completes), STOP parks again (TRM registers 3.4 and 3.8).
+ */
+static void test_link_park_stop(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    /* Reset values */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)), ==, OUTLINK_PARK);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_LINK)), ==, INLINK_PARK | INLINK_AUTO_RET);
+
+    /*
+     * Peripheral (non M2M) OUT chain: START arms it immediately, the data
+     * waits for a peripheral pump, so the FSM leaves the park state.
+     */
+    build_fixture(qts, src, false, false, 0);
+    wr(qts, CH_OUT_REG(0, REG_LINK), (OUT_DESC & OUTLINK_ADDR_M) | OUTLINK_START);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, 0);
+
+    /* STOP parks the channel and drops the pending chain */
+    wr(qts, CH_OUT_REG(0, REG_LINK), OUTLINK_STOP);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, OUTLINK_PARK);
+    /* START/RESTART/STOP are self-clearing */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) &
+                    (OUTLINK_START | OUTLINK_RESTART | OUTLINK_STOP), ==, 0);
+
+    qtest_quit(qts);
+}
