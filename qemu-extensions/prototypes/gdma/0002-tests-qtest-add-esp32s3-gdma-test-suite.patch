+/*
+ * Burst-alignment window discrimination (TRM tables 3.4-2/3.4-3):
+ * an internal-RAM receive descriptor that is word-aligned but NOT
+ * 16-byte aligned is valid with burst enabled; the external block
+ * alignment must not leak onto internal descriptors.
+ */
+static void test_inlink_internal_word_alignment(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    build_fixture(qts, src, false, false, 0);
+    /* Word-aligned but not 16-byte aligned: valid for internal RAM */
+    write_desc(qts, IN_DESC, DESC(36, 0, false, true), DST_AREA + 4, 0);
+    wr(qts, CH_IN_REG(0, REG_CONF0), BIT(2) /* DSCR_BURST_EN */);
+    wr(qts, CH_IN_REG(0, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, 0);
+
+    /* 8-byte aligned is still not word-aligned-blocked: valid too */
+    write_desc(qts, IN_DESC, DESC(32, 0, false, true), DST_AREA + 8, 0);
+    wr(qts, CH_IN_REG(0, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, 0);
+
+    /* Not word-aligned: descriptor error (TRM table 3.4-2) */
+    write_desc(qts, IN_DESC, DESC(30, 0, false, true), DST_AREA + 2, 0);
+    wr(qts, CH_IN_REG(0, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, IN_DSCR_ERR);
+
+    qtest_quit(qts);
+}
+
+/*
+ * System reset returns every register to its reset value (device cold
+ * reset path), including the LINK park/auto-ret defaults.
+ */
+static void test_system_reset(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+    QDict *rsp;
+
+    build_fixture(qts, src, false, false, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, !=, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_BF0_DESC_ADDR)), !=, 0);
+
+    rsp = qtest_qmp(qts, "{ 'execute': 'system_reset' }");
+    qobject_unref(rsp);
+    /* Reset happens asynchronously; wait for the machine to come back */
+    qtest_qmp_eventwait(qts, "RESET");
+
+    for (uint32_t ch = 0; ch < 2; ch++) {
+        g_assert_cmphex(rd(qts, CH_OUT_REG(ch, REG_INT_RAW)), ==, 0);
+        g_assert_cmphex(rd(qts, CH_IN_REG(ch, REG_INT_RAW)), ==, 0);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(ch, REG_BF0_DESC_ADDR)), ==, 0);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(ch, REG_STATE)), ==, 0);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(ch, REG_LINK)), ==, OUTLINK_PARK);
+        g_assert_cmphex(rd(qts, CH_IN_REG(ch, REG_LINK)), ==,
+                        INLINK_PARK | INLINK_AUTO_RET);
+    }
+
+    qtest_quit(qts);
+}
