+/*
+ * Malicious descriptor chains must never hang QEMU:
+ * - a zero-length self-referential cycle makes no progress: bounded DSCR_ERR;
+ * - a byte-moving self-loop keeps walking until the receive list runs out:
+ *   bounded IN_DSCR_EMPTY halt.
+ */
+static void test_malicious_self_loop(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    /* Zero-length self-loop on the OUT side */
+    build_fixture(qts, src, false, false, 0);
+    write_desc(qts, OUT_DESC, DESC(0, 0, false, true), SRC_AREA, OUT_DESC);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, OUT_DSCR_ERR);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+
+    /* Byte-moving self-loop: OUT cycles, IN chain is finite */
+    clear_ints(qts, 0);
+    build_fixture(qts, src, true, false, 0);
+    write_desc(qts, OUT_DESC + 24, DESC(32, 32, false, true), SRC_AREA + 64,
+               OUT_DESC);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_EMPTY, ==,
+                    IN_DSCR_EMPTY);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DONE, ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+    /* Receive buffers were filled round-robin until the list ran out */
+    uint8_t dst[96];
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Two channels running different payloads concurrently must never
+ * interfere (CORE-04: five channels, no cross-channel consumption).
+ */
+static void test_dual_channel_independent(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src0[96], src1[96];
+    uint8_t dst[96];
+
+    for (int i = 0; i < 96; i++) {
+        src0[i] = (uint8_t)(0x40 + i);
+        src1[i] = (uint8_t)(0x80 + i);
+    }
+    qtest_memwrite(qts, SRC_AREA, src0, 96);
+    qtest_memwrite(qts, SRC_AREA + 0x100, src1, 96);
+
+    /* Channel 0: SRC_AREA -> DST_AREA; channel 1: SRC+0x100 -> DST+0x100 */
+    for (uint32_t ch = 0; ch < 2; ch++) {
+        uint32_t src_addr = SRC_AREA + 0x100 * ch;
+        uint32_t dst_addr = DST_AREA + 0x100 * ch;
+        qtest_memset(qts, dst_addr, 0xEE, 96);
+        write_desc(qts, OUT_DESC + 0x40 * ch,
+                   DESC(32, 32, false, true), src_addr, OUT_DESC + 0x40 * ch + 12);
+        write_desc(qts, OUT_DESC + 0x40 * ch + 12,
+                   DESC(32, 32, false, true), src_addr + 32, OUT_DESC + 0x40 * ch + 24);
+        write_desc(qts, OUT_DESC + 0x40 * ch + 24,
+                   DESC(32, 32, true, true), src_addr + 64, 0);
+        write_desc(qts, IN_DESC + 0x40 * ch,
+                   DESC(32, 0, false, true), dst_addr, IN_DESC + 0x40 * ch + 12);
+        write_desc(qts, IN_DESC + 0x40 * ch + 12,
+                   DESC(32, 0, false, true), dst_addr + 32, IN_DESC + 0x40 * ch + 24);
+        write_desc(qts, IN_DESC + 0x40 * ch + 24,
+                   DESC(32, 0, false, true), dst_addr + 64, 0);
+        wr(qts, CH_IN_REG(ch, REG_CONF0), IN_MEM_TRANS_EN);
+        wr(qts, CH_IN_REG(ch, REG_LINK), ((IN_DESC + 0x40 * ch) & INLINK_ADDR_M) | INLINK_START);
+    }
+    /* Both OUT chains start at the same register write "time" */
+    wr(qts, CH_OUT_REG(0, REG_LINK), (OUT_DESC & OUTLINK_ADDR_M) | OUTLINK_START);
+    wr(qts, CH_OUT_REG(1, REG_LINK), ((OUT_DESC + 0x40) & OUTLINK_ADDR_M) | OUTLINK_START);
+
+    for (uint32_t ch = 0; ch < 2; ch++) {
+        g_assert_cmphex(rd(qts, CH_OUT_REG(ch, REG_INT_RAW)), ==,
+                        OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+        g_assert_cmphex(rd(qts, CH_IN_REG(ch, REG_INT_RAW)), ==,
+                        IN_DONE | IN_SUC_EOF);
+    }
+
+    qtest_memread(qts, DST_AREA, dst, 32);
+    g_assert_cmpmem(dst, 32, src0, 32);
+    qtest_memread(qts, DST_AREA + 0x100, dst, 32);
+    g_assert_cmpmem(dst, 32, src1, 32);
+
+    qtest_quit(qts);
+}
