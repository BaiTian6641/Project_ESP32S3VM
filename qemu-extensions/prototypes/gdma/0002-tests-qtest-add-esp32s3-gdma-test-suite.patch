From a6809c51f0eb06fa21f7a1095969c6d81963ca9f Mon Sep 17 00:00:00 2001
From: ESP32S3VM gdma <gdma@esp32s3vm.invalid>
Date: Wed, 7 Oct 2026 11:41:58 +0800
Subject: [PATCH 2/5] tests/qtest: add esp32s3-gdma-test suite

Drive the esp32s3.gdma controller through MMIO and guest RAM descriptor
tables (16 cases): 3-descriptor ring/chain transfer with owner hand-off,
owner/window/burst-alignment errors with bounded stop, external-RAM
window audit, RESTART cursor reuse of a ring, work-quantum streaming of
a valid double ring with mid-stream channel reset, zero-length
self-loop and byte-moving self-loop bounded failure, dual-channel
independence, PERI_SEL register masking, LINK PARK/STOP semantics,
partial descriptor boundaries, internal-RAM word-alignment window
discrimination, QMP responsiveness with a running vCPU across many
quanta, non-cumulative walk bound for endless streams, repeated
RESTART streaming, and system reset values.
---
 tests/qtest/esp32s3-gdma-test.c | 903 ++++++++++++++++++++++++++++++++
 tests/qtest/meson.build         |   2 +-
 2 files changed, 904 insertions(+), 1 deletion(-)
 create mode 100644 tests/qtest/esp32s3-gdma-test.c

diff --git a/tests/qtest/esp32s3-gdma-test.c b/tests/qtest/esp32s3-gdma-test.c
new file mode 100644
index 0000000..a06f8e6
--- /dev/null
+++ b/tests/qtest/esp32s3-gdma-test.c
@@ -0,0 +1,903 @@
+/*
+ * QTest suite for the ESP32-S3 GDMA controller (esp32s3.gdma)
+ *
+ * Copyright (c) 2026 ESP32S3VM project
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ *
+ * Exercises the bounded descriptor engine per docs/plans/peripherals-
+ * electrical.md CORE-04 and TRM chapter 3: descriptor ring walking with
+ * owner hand-off, descriptor errors (owner/window/alignment/zero-length
+ * cycles), restart cursors, dual-channel independence, channel reset and
+ * work-quantum streaming.
+ *
+ * The GDMA engine is driven purely through MMIO and guest RAM descriptors;
+ * the machine boots in paused state (-S), no firmware runs.
+ */
+
+#include "qemu/osdep.h"
+#include "libqtest.h"
+#include "qemu/bitops.h"
+
+/* GDMA register block, TRM 3.7 */
+#define GDMA_BASE           0x6003F000u
+#define GDMA_CHAN_STRIDE    0xC0u
+#define GDMA_OUT_OFF        0x60u
+
+/* Offsets inside one direction block */
+#define REG_CONF0           0x000
+#define REG_CONF1           0x004
+#define REG_INT_RAW         0x008
+#define REG_INT_ST          0x00C
+#define REG_INT_ENA         0x010
+#define REG_INT_CLR         0x014
+#define REG_FIFO_ST         0x018
+#define REG_LINK            0x020
+#define REG_STATE           0x024
+#define REG_SUC_EOF_DESC    0x028
+#define REG_ERR_EOF_DESC    0x02C
+#define REG_DESC_ADDR       0x030
+#define REG_BF0_DESC_ADDR   0x034
+#define REG_BF1_DESC_ADDR   0x038
+#define REG_PERI_SEL        0x048
+
+#define CH_IN_REG(ch, reg)  (GDMA_BASE + GDMA_CHAN_STRIDE * (ch) + (reg))
+#define CH_OUT_REG(ch, reg) (GDMA_BASE + GDMA_CHAN_STRIDE * (ch) + GDMA_OUT_OFF + (reg))
+
+/* IN_CONF0 */
+#define IN_MEM_TRANS_EN     BIT(4)
+/* OUT_CONF0 */
+#define OUT_AUTO_WRBACK     BIT(2)
+/* CONF1 */
+#define CHECK_OWNER         BIT(12)
+/* Interrupt bits, TRM 3.5 */
+#define IN_DONE             BIT(0)
+#define IN_SUC_EOF          BIT(1)
+#define IN_ERR_EOF          BIT(2)
+#define IN_DSCR_ERR         BIT(3)
+#define IN_DSCR_EMPTY       BIT(4)
+#define OUT_DONE            BIT(0)
+#define OUT_EOF             BIT(1)
+#define OUT_DSCR_ERR        BIT(2)
+#define OUT_TOTAL_EOF       BIT(3)
+/* INLINK */
+#define INLINK_PARK         BIT(24)
+#define INLINK_RESTART      BIT(23)
+#define INLINK_START        BIT(22)
+#define INLINK_STOP         BIT(21)
+#define INLINK_AUTO_RET     BIT(20)
+#define INLINK_ADDR_M       0xFFFFFu
+/* OUTLINK */
+#define OUTLINK_PARK        BIT(23)
+#define OUTLINK_RESTART     BIT(22)
+#define OUTLINK_START       BIT(21)
+#define OUTLINK_STOP        BIT(20)
+#define OUTLINK_ADDR_M      0xFFFFFu
+
+/* Internal RAM, machine "esp32s3.dram" region */
+#define DRAM_BASE           0x3FC80000u
+
+/* Descriptor (TRM 3.4.1) */
+#define DESC(size, length, suc_eof, owner) \
+    ((uint32_t)(size) | ((uint32_t)(length) << 12) | \
+     ((suc_eof) ? BIT(30) : 0) | ((owner) ? BIT(31) : 0))
+
+typedef struct Desc {
+    uint32_t dw0;
+    uint32_t buf;
+    uint32_t next;
+} QEMU_PACKED Desc;
+
+/* Scratch layout inside DRAM (96 bytes of data per slot) */
+#define SRC_AREA    0x3FC90000u     /* source data, second channel at +0x100 */
+#define OUT_DESC    0x3FC90200u     /* out descriptors, 0x40 per channel */
+#define IN_DESC     0x3FC90300u     /* in descriptors, 0x40 per channel */
+#define DST_AREA    0x3FC90400u     /* destination data, second channel at +0x100 */
+
+static inline void wr(QTestState *qts, uint32_t addr, uint32_t val)
+{
+    qtest_writel(qts, addr, val);
+}
+
+static inline uint32_t rd(QTestState *qts, uint32_t addr)
+{
+    return qtest_readl(qts, addr);
+}
+
+static void write_desc(QTestState *qts, uint32_t addr, uint32_t dw0,
+                       uint32_t buf, uint32_t next)
+{
+    Desc d = { dw0, buf, next };
+    qtest_memwrite(qts, addr, &d, sizeof(d));
+}
+
+static Desc read_desc(QTestState *qts, uint32_t addr)
+{
+    Desc d;
+    qtest_memread(qts, addr, &d, sizeof(d));
+    return d;
+}
+
+/*
+ * Build the canonical 3-descriptor chain/ring fixture:
+ * out: d0(32B) -> d1(32B) -> d2(32B, suc_eof) -> next
+ * in : e0(32B) -> e1(32B) -> e2(32B)       -> next
+ * Source pattern (96 bytes) at SRC_AREA, destination cleared at DST_AREA.
+ * `src` must point to at least 96 bytes.
+ */
+static void build_fixture(QTestState *qts, uint8_t *src, bool out_ring,
+                          bool in_ring, uint32_t dw0_or)
+{
+    uint32_t d_next = out_ring ? OUT_DESC : 0;
+    uint32_t e_next = in_ring ? IN_DESC : 0;
+
+    for (int i = 0; i < 96; i++) {
+        src[i] = (uint8_t)(0x10 + i);
+    }
+    qtest_memwrite(qts, SRC_AREA, src, 96);
+    qtest_memset(qts, DST_AREA, 0xEE, 96);
+
+    /* Owner is set by software before handing the list to GDMA */
+    write_desc(qts, OUT_DESC + 0, DESC(32, 32, false, true) | dw0_or, SRC_AREA,
+               OUT_DESC + 12);
+    write_desc(qts, OUT_DESC + 12, DESC(32, 32, false, true) | dw0_or,
+               SRC_AREA + 32, OUT_DESC + 24);
+    write_desc(qts, OUT_DESC + 24, DESC(32, 32, true, true) | dw0_or,
+               SRC_AREA + 64, d_next);
+
+    /* Receive descriptors: software clears suc_eof and hands ownership */
+    write_desc(qts, IN_DESC + 0, DESC(32, 0, false, true) | dw0_or, DST_AREA,
+               IN_DESC + 12);
+    write_desc(qts, IN_DESC + 12, DESC(32, 0, false, true) | dw0_or,
+               DST_AREA + 32, IN_DESC + 24);
+    write_desc(qts, IN_DESC + 24, DESC(32, 0, false, true) | dw0_or,
+               DST_AREA + 64, e_next);
+}
+
+static void start_m2m(QTestState *qts, uint32_t ch)
+{
+    /* MEM_TRANS_EN alone does not trigger (no pending START yet) */
+    wr(qts, CH_IN_REG(ch, REG_CONF0), IN_MEM_TRANS_EN);
+    wr(qts, CH_IN_REG(ch, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    /* The OUTLINK START write services the pending INLINK START: M2M runs */
+    wr(qts, CH_OUT_REG(ch, REG_LINK), (OUT_DESC & OUTLINK_ADDR_M) | OUTLINK_START);
+}
+
+static void clear_ints(QTestState *qts, uint32_t ch)
+{
+    wr(qts, CH_IN_REG(ch, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_OUT_REG(ch, REG_INT_CLR), 0xFFFFFFFFu);
+}
+
+/* --- Tests -------------------------------------------------------------- */
+
+/*
+ * Mem-to-mem across a 3-descriptor chain: data moved in order, owner
+ * hand-off observed in guest memory (OUT via AUTO_WRBACK, IN always),
+ * exact interrupt statuses, EOF descriptor registers per TRM 3.5.
+ */
+static void test_m2m_chain_owner(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+    Desc d;
+
+    build_fixture(qts, src, false, false, 0);
+    /* Owner check enabled on both directions, AUTO_WRBACK on OUT */
+    wr(qts, CH_IN_REG(0, REG_CONF1), CHECK_OWNER);
+    wr(qts, CH_OUT_REG(0, REG_CONF1), CHECK_OWNER);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+
+    start_m2m(qts, 0);
+
+    /* Exact statuses: OUT DONE|EOF|TOTAL_EOF, IN DONE|SUC_EOF */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==,
+                    OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)), ==,
+                    IN_DONE | IN_SUC_EOF);
+    /* No error reported */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, 0);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, 0);
+
+    /* Masked status follows ENA */
+    wr(qts, CH_OUT_REG(0, REG_INT_ENA), OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_ST)), ==,
+                    OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+
+    /* Data landed at the destination */
+    uint8_t dst[96];
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpmem(dst, 96, src, 96);
+
+    /* Owner transitions: OUT descriptors cleared by AUTO_WRBACK */
+    d = read_desc(qts, OUT_DESC);
+    g_assert_cmphex(d.dw0 & BIT(31), ==, 0);
+    d = read_desc(qts, OUT_DESC + 24);
+    g_assert_cmphex(d.dw0 & BIT(31), ==, 0);
+    g_assert_cmphex(d.dw0 & BIT(30), ==, BIT(30)); /* suc_eof kept */
+
+    /* IN descriptors: owner cleared by hardware, length written back;
+     * the final one gets suc_eof from hardware (checked below) */
+    for (int i = 0; i < 2; i++) {
+        d = read_desc(qts, IN_DESC + 12 * i);
+        g_assert_cmphex(d.dw0 & BIT(31), ==, 0);
+        g_assert_cmphex((d.dw0 >> 12) & 0xFFF, ==, 32);
+        g_assert_cmphex(d.dw0 & BIT(30), ==, 0);
+    }
+    /* Hardware sets suc_eof on the final receive descriptor (EOF data) */
+    d = read_desc(qts, IN_DESC + 24);
+    g_assert_cmphex(d.dw0 & BIT(30), ==, BIT(30));
+
+    /* EOF descriptor registers: last processed descriptors */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_SUC_EOF_DESC)), ==, OUT_DESC + 24);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_SUC_EOF_DESC)), ==, IN_DESC + 24);
+
+    /* Cursor trail per TRM 3.27..3.29/3.34..3.36: BF0 = last current */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_BF0_DESC_ADDR)), ==, OUT_DESC + 24);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_BF1_DESC_ADDR)), ==, OUT_DESC + 12);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_BF0_DESC_ADDR)), ==, IN_DESC + 24);
+
+    /* Chain done: both FSMs parked (LINK.PARK reads 1) */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, OUTLINK_PARK);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_LINK)) & INLINK_PARK, ==, INLINK_PARK);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Error descriptor in the middle of the chain: bad owner on d1 with
+ * CHECK_OWNER set raises DSCR_ERR and halts the channel; d2 is never
+ * touched and DONE never fires (EOF-after-error per TRM 3.4.6: halt).
+ */
+static void test_error_owner_mid_chain(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    build_fixture(qts, src, false, false, 0);
+    /* Revoke ownership of the second OUT descriptor */
+    write_desc(qts, OUT_DESC + 12, DESC(32, 32, false, false), SRC_AREA + 32,
+               OUT_DESC + 24);
+    wr(qts, CH_IN_REG(0, REG_CONF1), CHECK_OWNER);
+    wr(qts, CH_OUT_REG(0, REG_CONF1), CHECK_OWNER);
+
+    start_m2m(qts, 0);
+
+    /* Per-direction descriptor checks (TRM 3.5): only the OUT side errored */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==, OUT_DSCR_ERR);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)), ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+
+    /* Only the first buffer was copied, the rest is untouched */
+    uint8_t dst[96];
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+    g_assert_cmpint(dst[31], ==, src[31]);
+    for (int i = 0; i < 32; i++) {
+        g_assert_cmpint(dst[32 + i], ==, 0xEE);
+        g_assert_cmpint(dst[64 + i], ==, 0xEE);
+    }
+
+    /* Erroring OUT descriptor address observable; IN trail untouched */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_ERR_EOF_DESC)), ==, OUT_DESC + 12);
+    /* The channel is halted: PARK reads 1 */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, OUTLINK_PARK);
+
+    /*
+     * TRM 3.4.6: after a descriptor error software must reset the channel
+     * before starting again; RESTART alone does not clear the halt.
+     */
+    wr(qts, CH_IN_REG(0, REG_LINK), INLINK_RESTART);
+    wr(qts, CH_OUT_REG(0, REG_LINK), OUTLINK_RESTART);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+    /* Software fixes the descriptor ownership, resets the channel... */
+    write_desc(qts, OUT_DESC + 12, DESC(32, 32, false, true), SRC_AREA + 32,
+               OUT_DESC + 24);
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN | 1); /* RST=1 */
+    wr(qts, CH_OUT_REG(0, REG_CONF0), 1);
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN);     /* RST 1->0 */
+    wr(qts, CH_OUT_REG(0, REG_CONF0), 0);
+    clear_ints(qts, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, !=, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Descriptor window checks (TRM 3.4.6): a buffer address outside the
+ * internal/external RAM windows and a next-descriptor address outside
+ * internal RAM both raise DSCR_ERR and halt.
+ */
+static void test_error_bad_addresses(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    /* DW1 pointing at a peripheral window */
+    build_fixture(qts, src, false, false, 0);
+    write_desc(qts, OUT_DESC, DESC(32, 32, true, true), 0x6003F000, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, OUT_DSCR_ERR);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+
+    /* DW2 (next descriptor) outside internal RAM */
+    clear_ints(qts, 0);
+    build_fixture(qts, src, false, false, 0);
+    write_desc(qts, OUT_DESC, DESC(32, 32, false, true), SRC_AREA, 0x60020000);
+    write_desc(qts, OUT_DESC + 12, DESC(32, 32, true, true), SRC_AREA + 32, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, OUT_DSCR_ERR);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+
+    /*
+     * External RAM window passes the TRM 3.4.6 address check but no PSRAM
+     * is modeled in this machine: the transfer fails at the bus and is
+     * reported as a descriptor error (no silent success, CORE-04 memory
+     * path audit).
+     */
+    clear_ints(qts, 0);
+    build_fixture(qts, src, false, false, 0);
+    write_desc(qts, OUT_DESC, DESC(32, 32, true, true), 0x3C000000, 0);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, OUT_DSCR_ERR);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, ==, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Burst alignment (TRM table 3.4-2): with inlink burst enabled, a receive
+ * descriptor with non word-aligned size or buffer address is an error.
+ */
+static void test_error_inlink_burst_alignment(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    build_fixture(qts, src, false, false, 0);
+    /* Unaligned size (not word-aligned) and unaligned buffer address */
+    write_desc(qts, IN_DESC, DESC(30, 0, false, true), DST_AREA + 2, IN_DESC + 12);
+    write_desc(qts, IN_DESC + 12, DESC(64, 0, false, true), DST_AREA + 32, 0);
+    /* Peripheral receive chain: burst enabled, no MEM_TRANS_EN */
+    wr(qts, CH_IN_REG(0, REG_CONF0), BIT(2) /* DSCR_BURST_EN */);
+    wr(qts, CH_IN_REG(0, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, IN_DSCR_ERR);
+
+    /* The same descriptors pass with burst disabled: reset, then re-start */
+    wr(qts, CH_IN_REG(0, REG_CONF0), 1);
+    wr(qts, CH_IN_REG(0, REG_CONF0), 0);
+    wr(qts, CH_IN_REG(0, REG_INT_CLR), 0xFFFFFFFFu);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) & IN_DSCR_ERR, ==, 0);
+    /* The armed peripheral chain leaves the park state */
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_LINK)) & INLINK_PARK, ==, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Restart cursor: after the ring transfer finishes, appending new data by
+ * rewriting DW2 of the last descriptor and issuing RESTART re-walks the
+ * ring from its first descriptor (TRM 3.4.5) and copies the new content.
+ */
+static void test_ring_restart_cursor(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+
+    /*
+     * Double ring with the EOF flag on the third OUT descriptor: suc_eof
+     * ends the transfer phase (OUT_EOF) but the ring continues (DW2 != 0),
+     * so TRM 3.5 OUT_TOTAL_EOF (whole list sent) does not fire.
+     */
+    build_fixture(qts, src, true, true, 0);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==, OUT_DONE | OUT_EOF);
+
+    /* Update the source data, then re-walk the ring through RESTART */
+    for (int i = 0; i < 32; i++) {
+        src[i] = (uint8_t)(0xA0 + i);
+    }
+    qtest_memwrite(qts, SRC_AREA, src, 32);
+    clear_ints(qts, 0);
+
+    wr(qts, CH_IN_REG(0, REG_LINK), INLINK_RESTART);
+    wr(qts, CH_OUT_REG(0, REG_LINK), OUTLINK_RESTART);
+
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==, OUT_DONE | OUT_EOF);
+    uint8_t dst[96];
+    qtest_memread(qts, DST_AREA, dst, 96);
+    for (int i = 0; i < 32; i++) {
+        g_assert_cmpint(dst[i], ==, (uint8_t)(0xA0 + i));
+    }
+
+    qtest_quit(qts);
+}
+
+/*
+ * Work quantum streaming: an EOF-less double ring is valid circular
+ * streaming (CORE-04). The engine must yield at the quantum boundary with
+ * the channel still armed (PARK=0), keep making progress across timer
+ * deadlines, never hang, and leave a clean state on channel reset.
+ */
+static void test_ring_streaming_quantum(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+    uint8_t dst[96];
+
+    /* Rings on both sides, no suc_eof anywhere */
+    build_fixture(qts, src, true, true, 0);
+    write_desc(qts, OUT_DESC + 24, DESC(32, 32, false, true), SRC_AREA + 64,
+               OUT_DESC);
+    write_desc(qts, IN_DESC + 24, DESC(32, 0, false, true), DST_AREA + 64,
+               IN_DESC);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+
+    /* Still streaming: armed (PARK=0), no error, no DONE */
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, 0);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_LINK)) & INLINK_PARK, ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) &
+                    (OUT_DSCR_ERR | OUT_DONE), ==, 0);
+
+    /* The quantum copied several ring laps already */
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+
+    /* Progress continues across scheduled quanta */
+    for (int round = 0; round < 10; round++) {
+        g_usleep(G_USEC_PER_SEC / 50);
+        qtest_memread(qts, DST_AREA, dst, 96);
+        g_assert_cmpint(dst[round % 96], ==, src[round % 96]);
+    }
+
+    /* Reset both channels mid-stream: clean state (CORE-04) */
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN | 1);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), 1);
+    g_usleep(G_USEC_PER_SEC / 50);
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), 0);
+
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_STATE)), ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_DESC_ADDR)), ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_BF0_DESC_ADDR)), ==, 0);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_STATE)), ==, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, OUTLINK_PARK);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_LINK)) & INLINK_PARK, ==, INLINK_PARK);
+
+    /* The engine is usable again after the reset */
+    clear_ints(qts, 0);
+    build_fixture(qts, src, false, false, 0);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==,
+                    OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+
+    qtest_quit(qts);
+}
