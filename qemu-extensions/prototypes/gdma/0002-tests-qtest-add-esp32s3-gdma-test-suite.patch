+    qtest_add_func("/esp32s3-gdma/m2m-chain-owner", test_m2m_chain_owner);
+    qtest_add_func("/esp32s3-gdma/error-owner-mid-chain", test_error_owner_mid_chain);
+    qtest_add_func("/esp32s3-gdma/error-bad-addresses", test_error_bad_addresses);
+    qtest_add_func("/esp32s3-gdma/error-inlink-burst-alignment",
+                   test_error_inlink_burst_alignment);
