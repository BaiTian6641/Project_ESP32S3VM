+/*
+ * Partial bursts across a descriptor boundary: two OUT descriptors of
+ * different sizes feeding one IN descriptor move every byte exactly once.
+ */
+static void test_partial_descriptor_boundary(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[48];
+    uint8_t dst[48];
+
+    for (int i = 0; i < 48; i++) {
+        src[i] = (uint8_t)(0xC0 + i);
+    }
+    qtest_memwrite(qts, SRC_AREA, src, 48);
+    qtest_memset(qts, DST_AREA, 0xEE, 48);
+
+    /* OUT: 20 bytes + 28 bytes; IN: one 48-byte buffer */
+    write_desc(qts, OUT_DESC, DESC(20, 20, false, true), SRC_AREA, OUT_DESC + 12);
+    write_desc(qts, OUT_DESC + 12, DESC(28, 28, true, true), SRC_AREA + 20, 0);
+    write_desc(qts, IN_DESC, DESC(48, 0, false, true), DST_AREA, 0);
+
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN);
+    wr(qts, CH_IN_REG(0, REG_LINK), (IN_DESC & INLINK_ADDR_M) | INLINK_START);
+    wr(qts, CH_OUT_REG(0, REG_LINK), (OUT_DESC & OUTLINK_ADDR_M) | OUTLINK_START);
+
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)), ==,
+                    OUT_DONE | OUT_EOF | OUT_TOTAL_EOF);
+    g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)), ==, IN_DONE | IN_SUC_EOF);
+
+    qtest_memread(qts, DST_AREA, dst, 48);
+    g_assert_cmpmem(dst, 48, src, 48);
+    /* IN descriptor written back with the full received length */
+    Desc d = read_desc(qts, IN_DESC);
+    g_assert_cmphex((d.dw0 >> 12) & 0xFFF, ==, 48);
+    g_assert_cmphex(d.dw0 & BIT(30), ==, BIT(30));
+    g_assert_cmphex(d.dw0 & BIT(31), ==, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Defect regressions (review 2026-10-07):
+ *
+ * 1. Quantum continuation must not starve the main loop: with the VM
+ *    actually running (-accel tcg, no -S, live vCPU and virtual clock),
+ *    QMP must answer promptly while a streaming ring runs through many
+ *    quanta, and data must keep flowing.
+ * 2. Burst alignment windows: internal-RAM receive descriptors are
+ *    word-aligned (TRM table 3.4-2) even when not 16-byte aligned; only
+ *    external-RAM descriptors take the EXT_MEM_BK_SIZE block alignment
+ *    (TRM table 3.4-3). The internal window (0x3FC88000..) lies
+ *    numerically above the external base (0x3C000000), so the window
+ *    test must be explicit.
+ * 3. The absolute walk bound is per scheduled quantum / per restart,
+ *    never cumulative: a valid EOF-less ring must keep streaming past
+ *    65536 total descriptor fetches without DSCR_ERR.
+ */
+static void test_streaming_qmp_responsive(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -accel tcg");
+    uint8_t src[96];
+    uint8_t dst[96];
+    int64_t start_ns;
+    int64_t max_round_ns = 0;
+
+    build_fixture(qts, src, true, true, 0);
+    write_desc(qts, OUT_DESC + 24, DESC(32, 32, false, true), SRC_AREA + 64,
+               OUT_DESC);
+    write_desc(qts, IN_DESC + 24, DESC(32, 0, false, true), DST_AREA + 64,
+               IN_DESC);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, 0);
+
+    /*
+     * The vCPU is executing and the virtual clock runs: every QMP command
+     * must complete within a generous wall-clock bound even while the
+     * streaming ring re-schedules its work quantum on every main-loop
+     * iteration.
+     */
+    start_ns = g_get_monotonic_time();
+    for (int i = 0; i < 20; i++) {
+        int64_t cmd_start = g_get_monotonic_time();
+        QDict *rsp = qtest_qmp(qts, "{ 'execute': 'query-status' }");
+        g_assert(qdict_haskey(rsp, "return"));
+        qobject_unref(rsp);
+        int64_t round = g_get_monotonic_time() - cmd_start;
+        max_round_ns = MAX(max_round_ns, round);
+        g_usleep(G_USEC_PER_SEC / 100);
+    }
+    /* Whole exchange bounded; each individual QMP command far below 1s */
+    g_assert_cmpint(g_get_monotonic_time() - start_ns, <, 30 * G_USEC_PER_SEC);
+    g_assert_cmpint(max_round_ns, <, G_USEC_PER_SEC);
+
+    /* Data kept flowing across the quanta */
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, 0);
+
+    /* Leave a clean state */
+    wr(qts, CH_IN_REG(0, REG_CONF0), IN_MEM_TRANS_EN | 1);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), 1);
+    qtest_qmp_assert_success(qts, "{ 'execute': 'quit' }");
+}
+
+/*
+ * An EOF-less double ring is a valid endless stream: the walk bound must
+ * not accumulate across quanta (regression for the cumulative 65536
+ * descriptor bound), the stream simply keeps flowing with no DSCR_ERR.
+ */
+static void test_streaming_walk_bound_not_cumulative(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+    uint8_t dst[96];
+
+    build_fixture(qts, src, true, true, 0);
+    write_desc(qts, OUT_DESC + 24, DESC(32, 32, false, true), SRC_AREA + 64,
+               OUT_DESC);
+    write_desc(qts, IN_DESC + 24, DESC(32, 0, false, true), DST_AREA + 64,
+               IN_DESC);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+
+    /*
+     * Each quantum fetches 256 descriptors (6 per ring lap), so roughly
+     * 256 quanta are needed to reach the old cumulative 65536 bound. The
+     * BH runs one quantum per main-loop iteration; poll well past that
+     * and assert the stream is error-free and still parked-in-motion.
+     */
+    for (int round = 0; round < 100; round++) {
+        g_usleep(G_USEC_PER_SEC / 200);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) &
+                        (OUT_DSCR_ERR | OUT_DONE), ==, 0);
+        g_assert_cmphex(rd(qts, CH_IN_REG(0, REG_INT_RAW)) &
+                        (IN_DSCR_ERR | IN_DSCR_EMPTY), ==, 0);
+    }
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_LINK)) & OUTLINK_PARK, ==, 0);
+
+    qtest_quit(qts);
+}
+
+/*
+ * RESTART-based streaming must not accumulate the walk bound either
+ * (regression: walk_count is reset on every RESTART arm).
+ */
+static void test_restart_stream_repeated(void)
+{
+    QTestState *qts = qtest_init("-M esp32s3 -S");
+    uint8_t src[96];
+    uint8_t dst[96];
+
+    build_fixture(qts, src, true, true, 0);
+    wr(qts, CH_OUT_REG(0, REG_CONF0), OUT_AUTO_WRBACK);
+    start_m2m(qts, 0);
+    g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, !=, 0);
+
+    for (int pass = 0; pass < 8; pass++) {
+        clear_ints(qts, 0);
+        wr(qts, CH_IN_REG(0, REG_LINK), INLINK_RESTART);
+        wr(qts, CH_OUT_REG(0, REG_LINK), OUTLINK_RESTART);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DONE, !=, 0);
+        g_assert_cmphex(rd(qts, CH_OUT_REG(0, REG_INT_RAW)) & OUT_DSCR_ERR, ==, 0);
+    }
+    qtest_memread(qts, DST_AREA, dst, 96);
+    g_assert_cmpint(dst[0], ==, src[0]);
+
+    qtest_quit(qts);
+}
