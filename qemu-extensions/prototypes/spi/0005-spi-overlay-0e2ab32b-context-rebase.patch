From: SpiNativeWorker <spi-native@localhost>
Date: Wed, 8 Oct 2026 00:00:00 +0000
Subject: [PATCH] spi: rebase overlay 0002/0003 meson+binding hunks onto
 0e2ab32b foundation

Additive context rebase only; frozen 0001..0003 patch inputs are NOT
rewritten. Against the final canonical graph foundation
(qemu-runtime-40edccac4156-0e2ab32b9d57dee3, fingerprint
0e2ab32b9d57dee3d0454e063153f820877477e692a145a380640cd3a3193ccd):

- 0002 tests/qtest/meson.build hunk context drifted: the foundation now
  registers esp32s3-adc-test and esp32s3-electrical-test. The SPI qtest
  registration is appended after the electrical registration instead.
- 0003 hw/ssi/meson.build hunk context drifted (ibex/bcm2835/pnv follow
  the esp32s3 lines). The binding source is appended directly after
  esp32s3_spi_service.c.
- 0003 hw/xtensa/esp32s3.c binding block context drifted: the typed
  pre-realize esp32s3_electrical_create(&ss->sens) hunk is already
  migrated in the foundation, so the bind block is anchored after that
  create call.

Line numbers below are against the post-0002/0003 state in the SPI-owned
checkout /home/polar/.cache/esp32s3vm/qemu-spi-40edccac4156-0e2ab32b.
No controller, service, binding or qtest semantics change; copy SHAs
remain the frozen snapshot values.
---
 hw/ssi/meson.build      | 1 +
 hw/xtensa/esp32s3.c     | 6 ++++++
 tests/qtest/meson.build | 1 +
 3 files changed, 8 insertions(+)

diff --git a/hw/ssi/meson.build b/hw/ssi/meson.build
--- a/hw/ssi/meson.build
+++ b/hw/ssi/meson.build
@@ -14,5 +14,6 @@ system_ss.add(when: 'CONFIG_XTENSA_ESP32', if_true: files('esp32_spi.c'))
 system_ss.add(when: 'CONFIG_RISCV_ESP32C3', if_true: files('esp32c3_spi.c'))
 system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('esp32s3_spi.c'))
 system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('esp32s3_spi_service.c'))
+system_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files('esp32s3_spi_binding.c'))
 system_ss.add(when: 'CONFIG_IBEX', if_true: files('ibex_spi_host.c'))
 system_ss.add(when: 'CONFIG_BCM2835_SPI', if_true: files('bcm2835_spi.c'))
diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -1407,4 +1407,10 @@ static void esp32s3_machine_init(MachineState *machine)
         esp32s3_electrical_create(OBJECT(ss), &ss->gpio, &ss->rtc_io,
                                 &ss->sens);
+        {
+            Object *electrical_object = object_resolve_path_component(OBJECT(ss), "electrical");
+            g_assert(electrical_object);
+            esp32s3_spi_bind_electrical(&ss->gpspi[0], &ss->gpspi[1], &ss->gpio,
+                                       DEVICE(electrical_object));
+        }
 
         sysbus_realize(SYS_BUS_DEVICE(&ss->sens), &error_fatal);
diff --git a/tests/qtest/meson.build b/tests/qtest/meson.build
--- a/tests/qtest/meson.build
+++ b/tests/qtest/meson.build
@@ -350,3 +350,4 @@ qtests_xtensa += ['esp32s3-adc-test']
 
 qtests_xtensa += [ 'esp32s3-electrical-test' ]
+qtests_xtensa += ['esp32s3-spi-test']
 
 qtests = {
-- 
