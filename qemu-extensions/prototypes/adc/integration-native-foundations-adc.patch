+/* ADC-SENS integration: named QOM GPIO inputs driven by esp32s3.sens
+ * (single SENS owner).  "sar2-armed" carries the derived arming level
+ * (SENS_SAR_MEAS2_CTRL2.EN_PAD_FORCE && !SAR_MEAS2_MUX.SAR2_RTC_FORCE);
+ * "tsens-dump-out" carries the SENS_SAR_TCTRL dump-out edge. */
+static void esp32s3_regi2c_sar2_armed_in(void *opaque, int n, int level)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    if (level) {
+        s->sens_ctrl2 |= SENS_SAR_MEAS2_CTRL2_EN_PAD_FORCE;
+        s->sens_mux &= ~SENS_SAR_MEAS2_MUX_RTC_FORCE;
+    } else {
+        s->sens_ctrl2 &= ~SENS_SAR_MEAS2_CTRL2_EN_PAD_FORCE;
+    }
+}
+
+static void esp32s3_regi2c_tsens_dump_in(void *opaque, int n, int level)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    esp32s3_sens_tctrl_write(s, level ? (s->sens_tctrl | SENS_TSENS_DUMP_OUT)
+                                      : (s->sens_tctrl & ~SENS_TSENS_DUMP_OUT));
+}
+
