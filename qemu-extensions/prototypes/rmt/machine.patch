diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -65,6 +65,8 @@
 #include "hw/misc/esp32s3_ds.h"
 #include "hw/timer/esp32s3_timg.h"
 #include "hw/timer/esp32s3_systimer.h"
+#include "hw/timer/esp32s3_rmt.h"
+#include "hw/timer/esp32s3_rmt_peers.h"
 #include "hw/gpio/esp32s3_gpio.h"
 #include "hw/gpio/esp32s3_iomux.h"
 #include "hw/misc/esp32s3_rtc_io.h"
@@ -138,6 +139,7 @@
     ESP32S3GPIOState gpio;
     ESP32S3IOMuxState iomux;
     ESP32S3RtcIoState rtc_io;
+    ESP32S3RmtState rmt;
     Esp32s3RngState rng;
     Esp32S3TWAIState twai;
 
@@ -354,6 +356,7 @@
     case ESP32S3_RST_SHA:      dev = DEVICE(&s->sha); break;
     case ESP32S3_RST_RSA:      dev = DEVICE(&s->rsa); break;
     case ESP32S3_RST_HMAC:     dev = DEVICE(&s->hmac); break;
+    case ESP32S3_RST_RMT:      dev = DEVICE(&s->rmt); break;
     case ESP32S3_RST_DS:       dev = DEVICE(&s->ds); break;
     default:
         break;
@@ -838,6 +841,7 @@
     object_initialize_child(OBJECT(ss), "sens", &ss->sens, TYPE_ESP32S3_SENS);
     object_initialize_child(OBJECT(ss), "apb_saradc", &ss->apb_saradc,
                             TYPE_ESP32S3_APB_SARADC);
+    object_initialize_child(OBJECT(ss), "rmt", &ss->rmt, TYPE_ESP32S3_RMT);
 
     /* ---------------------------------------------------------------------
      * Clock tree and reset-domain wiring, second stage (coreclk lane).
@@ -1227,5 +1231,31 @@
 
-    esp32s3_soc_add_unimp_device(sys_mem, "esp32s3.rmt", DR_REG_RMT_BASE, 0x1000);
+    {
+        DeviceState *electrical = DEVICE(object_resolve_path_component(
+            OBJECT(ss), "electrical"));
+        if (!electrical) {
+            error_setg(&error_fatal, "RMT requires the realized native electrical graph");
+            return;
+        }
+        esp32s3_rmt_peers_create(OBJECT(ss), electrical);
+        DeviceState *dev = DEVICE(&ss->rmt);
+        DeviceState *clk = DEVICE(&ss->clock);
+        object_property_set_link(OBJECT(dev), "gpio", OBJECT(&ss->gpio), &error_abort);
+        object_property_set_link(OBJECT(dev), "electrical", OBJECT(electrical), &error_abort);
+        object_property_set_link(OBJECT(dev), "gdma", OBJECT(&ss->gdma), &error_abort);
+        object_property_set_link(OBJECT(dev), "soc-reset", OBJECT(ss), &error_abort);
+        qdev_connect_clock_in(dev, "apb-clk", qdev_get_clock_out(clk, "apb-clk"));
+        qdev_connect_clock_in(dev, "xtal-clk", qdev_get_clock_out(clk, "xtal-clk"));
+        qdev_connect_clock_in(dev, "rc-fast-clk", qdev_get_clock_out(clk, "rc-fast-clk"));
+        qdev_connect_gpio_out_named(clk, ESP32S3_CLK_GATES_GPIO, ESP32S3_GATE_RMT,
+                                   qdev_get_gpio_in_named(dev, "clock-enable", 0));
+        qdev_connect_gpio_out_named(clk, ESP32S3_CLK_RST_LEVEL_GPIO, ESP32S3_RST_RMT,
+                                   qdev_get_gpio_in_named(dev, "reset-held", 0));
+        sysbus_realize(SYS_BUS_DEVICE(dev), &error_fatal);
+        memory_region_add_subregion_overlap(sys_mem, DR_REG_RMT_BASE,
+                                           sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 0);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(intmatrix_dev, ETS_RMT_INTR_SOURCE));
+    }
 
     esp32s3_machine_init_sd(ss);
 
