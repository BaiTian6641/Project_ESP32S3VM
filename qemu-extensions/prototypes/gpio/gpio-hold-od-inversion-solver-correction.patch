+/*
+ * Held pad under solver ownership (gpio-hold-od-inversion-solver-
+ * correction): while an electrical project is applied the solver owns
+ * the net report, and the held clamp must NOT overwrite net
+ * validity/level.  Setting a hold bit is strict-unsupported in the
+ * electrical profile: the solver fails and invalidates every net — the
+ * held clamp keeps that unresolved report (gpio-out reads 0) instead of
+ * fabricating a valid driven bit; clearing the hold restores the
+ * solver-resolved level.
+ */
+static void test_hold_solver_authority(void)
+{
+    QTestState *slp;
+    const uint64_t RTC_BASE = 0x60008000ULL;
+    QDict *r;
+
+    slp = qtest_initf("-machine esp32s3 -S -L pc-bios "
+                      "-global driver=esp32s3.gpio,property=strap_mode,value=0x00");
+    qtest_irq_intercept_out_named(slp, "/machine/soc/gpio", "gpio-out");
+
+    /* Pad 4 driven high by firmware: the solver resolves it HIGH
+     * (40 R native drive vs 10k pulldown -> ~3.29 V). */
+    qtest_writel(slp, IO_MUX_PAD(4), IOMUX_GPIO_IN_EN);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TS), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TS), BIT(4));
+    r = qtest_qmp(slp, "{'execute':'qom-set','arguments':{"
+                  "'path':'/machine/soc/electrical','property':'project-json',"
+                  "'value':%s}}", GPIO_HOLD_SOLVER_PROJECT_JSON);
+    g_assert_false(qdict_haskey(r, "error"));
+    qobject_unref(r);
+
+    /* Solver-resolved HIGH before the hold */
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+
+    /* Hold latches the effective HIGH; the electrical profile rejects
+     * the hold request (strict-unsupported) and invalidates the net:
+     * the clamp keeps the solver's unresolved report (line 0), never
+     * resurrects a fabricated driven bit. */
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+
+    /* Clearing the hold bit re-enables the solver: pad 4 resolves HIGH
+     * again (hold-transition refresh ordering, end to end). */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+
+    /* Cleanup */
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TC), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TC), BIT(4));
+    qtest_writel(slp, IO_MUX_PAD(4), 0);
+    qtest_quit(slp);
+}
