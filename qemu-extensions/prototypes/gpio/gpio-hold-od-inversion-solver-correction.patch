+/*
+ * Held FUNC_OUT_INV_SEL (gpio-hold-od-inversion-solver-correction): the
+ * hold latch stores the EFFECTIVE (post-inversion) drive bit, so a held
+ * pad keeps driving the level the awake path drove (OUT bit 0 + INV ->
+ * held 1; OUT bit 1 + INV -> held 0).  Register writes after hold-set
+ * never change the frozen level.
+ */
+static void test_hold_out_inversion(void)
+{
+    QTestState *slp;
+    const uint64_t RTC_BASE = 0x60008000ULL;
+
+    slp = qtest_initf("-machine esp32s3 -L pc-bios -accel qtest");
+    qtest_irq_intercept_out_named(slp, "/machine/soc/gpio", "gpio-out");
+
+    /* Awake: OUT bit 0 + FUNC_OUT_INV_SEL -> drives 1 */
+    qtest_writel(slp, IO_MUX_PAD(4), IOMUX_GPIO_IN_EN);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TS), BIT(4));
+    qtest_writel(slp, FUNC_OUT(4), GPIO_FUNC_OUT_SEL_NONE |
+                 R_GPIO_FUNCn_OUT_SEL_CFG_FUNC_OUT_INV_SEL_MASK);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+
+    /* Hold latches the effective bit (1): flipping GPIO_OUT or the
+     * inversion register afterwards never changes the held level */
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TS), BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+    qtest_writel(slp, FUNC_OUT(4), GPIO_FUNC_OUT_SEL_NONE);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+
+    /* Clearing the hold bit un-holds immediately (raw OUT bit 1, no
+     * inversion -> still 1), then re-latch the inverted LOW: raw OUT 1
+     * + INV -> effective 0 -> the held pad clamps low */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+    qtest_writel(slp, FUNC_OUT(4), GPIO_FUNC_OUT_SEL_NONE |
+                 R_GPIO_FUNCn_OUT_SEL_CFG_FUNC_OUT_INV_SEL_MASK);
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, 0);
+
+    /* Cleanup */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    qtest_writel(slp, FUNC_OUT(4), GPIO_FUNC_OUT_SEL_NONE);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TC), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TC), BIT(4));
+    qtest_writel(slp, IO_MUX_PAD(4), 0);
+    qtest_quit(slp);
+}
