+/*
+ * Held open-drain polarity (gpio-hold-od-inversion-solver-correction):
+ * awake semantics — an open-drain pad driving 1 RELEASES the pad, driving
+ * 0 clamps it low.  The held clamp must match: a latched 1 releases the
+ * pad (external/floating follow the net), a latched 0 clamps it low
+ * against an external high driver.  Observable through the resolved
+ * gpio-out line (net->valid ? net->level : 0) and GPIO_IN.
+ */
+static void test_hold_open_drain_polarity(void)
+{
+    QTestState *slp;
+    const uint64_t RTC_BASE = 0x60008000ULL;
+
+    slp = qtest_initf("-machine esp32s3 -L pc-bios -accel qtest");
+    qtest_irq_intercept_out_named(slp, "/machine/soc/gpio", "gpio-out");
+
+    /* Latched 1: OD output high RELEASES.  No pull, no external driver:
+     * the released held net floats — the line reads 0 (unresolved) and
+     * the input samples 0 (permissive profile), never a fabricated
+     * driven-high bit. */
+    qtest_writel(slp, IO_MUX_PAD(4), IOMUX_GPIO_IN_EN);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TS), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TS), BIT(4));
+    qtest_writel(slp, PIN_REG(4), R_GPIO_PINn_PAD_DRIVER_MASK);
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, 0);
+
+    /* A released held pad follows a valid external driver */
+    qtest_set_irq_in(slp, "/machine/soc/gpio", "gpio-in", 4, 1);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+
+    /* Latched 0: OD output low CLAMPS.  A re-asserted external high
+     * driver meets the clamp: CONTENTION resolves to the clamped low
+     * under the digital policy — never a released pad following the
+     * external 1. */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TC), BIT(4));
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+    qtest_set_irq_in(slp, "/machine/soc/gpio", "gpio-in", 4, 1);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, 0);
+
+    /* Clearing the hold bit un-holds immediately: the awake OD pad with
+     * output 0 still clamps low; flipping the output to 1 releases it and
+     * the re-asserted external high driver shows through again. */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 0);
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TS), BIT(4));
+    qtest_set_irq_in(slp, "/machine/soc/gpio", "gpio-in", 4, 1);
+    g_assert_cmpint(qtest_get_irq(slp, 4), ==, 1);
+
+    /* Cleanup */
+    qtest_set_irq_in(slp, "/machine/soc/gpio", "gpio-in", 4, 0);
+    qtest_writel(slp, PIN_REG(4), 0);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TC), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TC), BIT(4));
+    qtest_writel(slp, IO_MUX_PAD(4), 0);
+    qtest_quit(slp);
+}
