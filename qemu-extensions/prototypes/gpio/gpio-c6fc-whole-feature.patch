 {
     uint32_t before = qtest_readl(s, GPIO(A_GPIO_IN));
 
     qtest_writel(s, GPIO(A_GPIO_IN), 0xFFFFFFFF);
     g_assert_cmphex(qtest_readl(s, GPIO(A_GPIO_IN)), ==, before);
     qtest_writel(s, GPIO(A_GPIO_IN1), 0xFFFFFFFF);
