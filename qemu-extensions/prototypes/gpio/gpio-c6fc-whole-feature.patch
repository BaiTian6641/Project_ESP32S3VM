 /* RUE/RDE are the RTC pad pull-up/down enables (IDF rtc_gpio_pullup_en) */
 static inline int rtc_io_pad_rue(ESP32S3RtcIoState *s, int n)
 {
     return s->pad[n] & (1u << 27);
