+/*
+ * Strict-unknown policy regressions (with -accel qtest the guest does
+ * not execute, so consumption is driven by the test's own MMIO reads):
+ *
+ * 1. enabled REAL floating pad (FUN_IE=1, no driver, no pull): the bank
+ *    read is a consumption event — the strict policy pauses the VM (no
+ *    fabricated bit).
+ * 2. enabled HOLE pad (unpopulated 22-25): the read returns the
+ *    documented hardware 0 and the VM STAYS RUNNING — a physically
+ *    absent pad is not floating indeterminate.  Pre-correction lineage
+ *    FAILS this case (paused).
+ */
+static bool wait_status(QTestState *q, const char *want)
+{
+    for (int i = 0; i < 30; i++) {
+        QDict *status = qtest_qmp(q, "{'execute': 'query-status'}");
+        QDict *ret = qdict_get_qdict(status, "return");
+        bool match = ret && g_strcmp0(qdict_get_str(ret, "status"), want) == 0;
+        qobject_unref(status);
+        if (match) {
+            return true;
+        }
+        g_usleep(100000);
+    }
+    return false;
+}
+
+static void test_strict_unknown_floating_pause(void)
+{
+    QTestState *strict = qtest_initf("-machine esp32s3 -L pc-bios "
+        "-global driver=esp32s3.gpio,property=strict-unknown,value=true");
+
+    qtest_writel(strict, IO_MUX_PAD(4), IOMUX_GPIO_IN_EN);
+    g_assert_cmphex(qtest_readl(strict, GPIO(A_GPIO_IN)), ==, 0);
+    g_assert_cmpint(wait_status(strict, "paused"), ==, 1);
+    qtest_quit(strict);
+}
+
+static void test_strict_unknown_hole_pad(void)
+{
+    QTestState *strict = qtest_initf("-machine esp32s3 -L pc-bios "
+        "-global driver=esp32s3.gpio,property=strict-unknown,value=true");
+
+    qtest_writel(strict, IO_MUX_PAD(22), IOMUX_GPIO_IN_EN);
+    g_assert_cmphex(qtest_readl(strict, GPIO(A_GPIO_IN)), ==, 0);
+    g_assert_cmpint(wait_status(strict, "running"), ==, 1);
+    qtest_writel(strict, IO_MUX_PAD(22), 0);
+    qtest_quit(strict);
+}
+
+/*
+ * Sleep-effective configuration (RTC_CNTL STATE0.SLEEP_EN x SLP_SEL):
+ * with SLEEP_EN latched and SLP_SEL set, the SLP_* set replaces the
+ * awake FUN_* controls.  A pad whose awake receiver is enabled but
+ * whose sleep receiver is disabled READS 0 while the chip is in the
+ * requested sleep mode (sleep config honored — no awake fallback);
+ * without SLEEP_EN the awake FUN_* state stays fully effective.
+ */
+static void test_sleep_effective_config(void)
+{
+    QTestState *slp;
+    uint32_t mux4 = 0x60009014;
+
+    /* Awake config: FUN_IE=1 driving pad 4 externally HIGH; SLP_SEL=1
+     * with SLP_IE=0 (sleep receiver disabled). */
+    slp = qtest_initf("-machine esp32s3 -L pc-bios -accel qtest "
+                      "-global driver=esp32s3.gpio,property=strict-unknown,value=true");
+    qtest_set_irq_in(slp, "/machine/soc/gpio", "gpio-in", 4, 1);
+    qtest_writel(slp, mux4, R_IO_MUX_GPIOn_FUN_IE_MASK |
+                 R_IO_MUX_GPIOn_SLP_SEL_MASK |
+                 (1u << R_IO_MUX_GPIOn_MCU_SEL_SHIFT));
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+
+    /* Latch SLEEP_EN: the sleep set becomes effective -> SLP_IE=0
+     * disables the receiver -> reads 0 (resolved per sleep config). */
+    qtest_writel(slp, 0x60008018, BIT(31));
+    g_assert_cmphex((qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4)), ==, 0);
+
+    /* Awake the chip (clear SLEEP_EN): FUN_IE effective again -> 1 */
+    qtest_writel(slp, 0x60008018, 0);
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+    qtest_quit(slp);
+}
+
+
+/*
+ * Pad hold through the RTC domain: RTC_CNTL_RTC_PAD_HOLD (0xd8, RTC
+ * pad 4 = bit 14) latches the resolved level; GPIO_OUT changes are
+ * ignored while held; clearing the hold resumes following.
+ */
+static void test_sleep_hold_latch(void)
+{
+    QTestState *slp;
+    const uint64_t RTC_BASE = 0x60008000ULL;
+
+    slp = qtest_initf("-machine esp32s3 -L pc-bios -accel qtest "
+                      "-global driver=esp32s3.gpio,property=strict-unknown,value=true");
+    /* RTC pad 4 = GPIO4: input buffer + drive first (hold latches at
+     * hold-set), then hold */
+    qtest_writel(slp, IO_MUX_PAD(4), IOMUX_GPIO_IN_EN);
+    qtest_writel(slp, GPIO(A_GPIO_ENABLE_W1TS), BIT(4));
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TS), BIT(4));
+    qtest_writel(slp, RTC_BASE + 0xd8, BIT(4));
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+
+    /* Flip GPIO_OUT low: hold keeps the pad at the latched level */
+    qtest_writel(slp, GPIO(A_GPIO_OUT_W1TC), BIT(4));
+    g_assert_cmphex(qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4), ==, BIT(4));
+
+    /* Clear hold: the pad follows GPIO_OUT again */
+    qtest_writel(slp, RTC_BASE + 0xd8, 0);
+    g_assert_cmphex((qtest_readl(slp, GPIO(A_GPIO_IN)) & BIT(4)), ==, 0);
+    qtest_quit(slp);
+}
