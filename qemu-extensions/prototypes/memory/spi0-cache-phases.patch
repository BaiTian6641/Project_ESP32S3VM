+static MemTxResult esp32s3_spi_write_with_attrs(void *opaque, hwaddr addr,
+                                                uint64_t value, unsigned size,
+                                                MemTxAttrs attrs)
+{
+    ESP32S3SpiState *s = ESP32S3_SPI(opaque);
+
+    if (s->cache_port && s->system_clock &&
+        (s->system_clock->perip_rst_en0 & ESP32S3_SPI01_MASK)) {
+        /* Shared SPI01 reset is level-held: guest writes cannot rearm phases. */
+        return MEMTX_DECODE_ERROR;
+    }
+    if (s->cache_port && addr == A_SPI_MEM_CMD && value) {
+        /* No fake completion from an empty independent SPI0 SSI bus. */
+        return MEMTX_DECODE_ERROR;
+    }
+    esp32s3_spi_write(opaque, addr, value, size);
+    return MEMTX_OK;
+}
