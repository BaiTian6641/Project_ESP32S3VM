+bool esp32s3_spi_psram_cache_ready(ESP32S3SpiState *s,
+                                  const SsiPsramState *psram, bool write)
+{
+    uint32_t ctrl;
+    uint32_t dummy;
+
+    /* Qualify the pinned 8 MiB STR QPI device, not an enable latch. */
+    if (!s || !s->cache_port || !s->system_clock ||
+        !(s->system_clock->perip_clk_en0 & ESP32S3_SPI01_MASK) ||
+        (s->system_clock->perip_rst_en0 & ESP32S3_SPI01_MASK) ||
+        !s->system_clock->pll_valid ||
+        !psram || psram->is_octal ||
+        psram->size_mbytes != 8 || !psram->qpi || psram->wrap32 ||
+        FIELD_EX32(s->misc, SPI_MEM_MISC, CS1_DIS)) {
+        return false;
+    }
+    ctrl = s->cache_sctrl;
+    if (!FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_SRAM_QIO) ||
+        FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_SRAM_DIO) ||
+        FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, SRAM_OCT) ||
+        FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_SCMD_4BYTE) ||
+        FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, SRAM_ADDR_BITLEN) != 23 ||
+        (s->smem_ddr & 0x7f000001) ||
+        FIELD_EX32(s->smem_ac, SPI_MEM_SMEM_AC, ECC_16TO18_BYTE_EN)) {
+        return false;
+    }
+    /* Pinned native functional mode: 80 MHz MSPI core / 2 = 40 MHz.
+     * Actual shared SoC gate/reset checked above; no analogue timing claim. */
+    if (s->core_clk_sel != 0 || s->sram_clk != 0x00010001) {
+        return false;
+    }
+    if (write) {
+        return FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_WCMD) &&
+               !FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_WR_SRAM_DUMMY) &&
+               FIELD_EX32(s->sram_dwr_cmd, SPI_MEM_SRAM_DWR_CMD, BITLEN) == 7 &&
+               FIELD_EX32(s->sram_dwr_cmd, SPI_MEM_SRAM_DWR_CMD, VALUE) == 0x38;
+    }
+    dummy = FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, SRAM_RDUMMY_CYCLELEN) + 1;
+    if (FIELD_EX32(s->smem_timing_cali, SPI_MEM_SMEM_TIMING_CALI, TIMING_CALI)) {
+        dummy += FIELD_EX32(s->smem_timing_cali, SPI_MEM_SMEM_TIMING_CALI,
+                            EXTRA_DUMMY_CYCLELEN);
+    }
+    return FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_RCMD) &&
+           FIELD_EX32(ctrl, SPI_MEM_CACHE_SCTRL, USR_RD_SRAM_DUMMY) &&
+           dummy == 6 &&
+           FIELD_EX32(s->sram_drd_cmd, SPI_MEM_SRAM_DRD_CMD, BITLEN) == 7 &&
+           FIELD_EX32(s->sram_drd_cmd, SPI_MEM_SRAM_DRD_CMD, VALUE) == 0xeb;
+}
