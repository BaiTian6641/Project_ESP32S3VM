--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -52,6 +52,7 @@
 
 #include "hw/nvram/esp32s3_efuse.h"
 #include "hw/xtensa/esp32s3_clk.h"
+#include "hw/xtensa/esp32s3_clk_defs.h"
 #include "hw/xtensa/esp32s3_reset_domain.h"
 #include "hw/qdev-clock.h"
 #include "hw/misc/esp32s3_regi2c.h"
@@ -166,6 +167,11 @@ typedef struct Esp32s3SocState {
     ESP32S3RegI2CState regi2c;
 
     uint32_t requested_reset;
+    bool cpu1_held_state;
+    bool cpu1_runstall_raw;
+    bool cpu1_stalled;
+    unsigned cpu1_resets_pending;
+    uint64_t cpu1_reset_count;
 } Esp32s3SocState;
 
 
@@ -209,6 +215,95 @@ static void esp32s3_cpu_reset(void* opaque, int n, int level)
     }
 }
 
+static void esp32s3_cpu1_update_stall(Esp32s3SocState *s)
+{
+    /* Both GPIO callbacks see the already-stored register, so a combined
+     * gate/RUNSTALL write cannot briefly release the core between callbacks. */
+    s->cpu1_held_state =
+        FIELD_EX32(s->clock.core1_control0, SYSTEM_CORE_1_CONTROL_0_REG,
+                   RESETING) ||
+        !FIELD_EX32(s->clock.core1_control0, SYSTEM_CORE_1_CONTROL_0_REG,
+                    CLKGATE_EN);
+    s->cpu1_runstall_raw =
+        FIELD_EX32(s->clock.core1_control0, SYSTEM_CORE_1_CONTROL_0_REG,
+                   RUNSTALL);
+    s->cpu1_stalled = s->cpu1_held_state || s->cpu1_runstall_raw ||
+                     s->rtc_cntl.cpu_stall_state[1] ||
+                     s->cpu1_resets_pending;
+    if (s->cpu1_stalled != s->cpu[1].env.runstall) {
+        /* A cold-held core has never consumed its HALT interrupt. Cancel
+         * that pending request before releasing it, otherwise CPU execution
+         * immediately halts again despite RUNSTALL having been cleared. */
+        if (!s->cpu1_stalled) {
+            cpu_reset_interrupt(CPU(&s->cpu[1]), CPU_INTERRUPT_HALT);
+        }
+        xtensa_runstall(&s->cpu[1].env, s->cpu1_stalled);
+    }
+}
+
+static void esp32s3_cpu1_control(void *opaque, int n, int level)
+{
+    esp32s3_cpu1_update_stall(ESP32S3_SOC(opaque));
+}
+
+static void esp32s3_cpu1_reset_on_cpu(CPUState *cpu, run_on_cpu_data data)
+{
+    Esp32s3SocState *s = data.host_ptr;
+
+    /* Reset outside the requesting MMIO TB, even when CPU1 resets itself
+     * or both cores share the single-thread TCG execution thread. */
+    xtensa_select_static_vectors(&s->cpu[1].env,
+                                 s->rtc_cntl.stat_vector_sel[1]);
+    remove_cpu_watchpoints(&s->cpu[1]);
+    cpu_reset(cpu);
+    s->cpu1_reset_count++;
+    s->cpu1_resets_pending--;
+    esp32s3_cpu1_update_stall(s);
+}
+
+static void esp32s3_cpu1_reset_req(void *opaque, int n, int level)
+{
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+
+    if (level) {
+        s->cpu1_resets_pending++;
+        esp32s3_cpu1_update_stall(s);
+        async_run_on_cpu(CPU(&s->cpu[1]), esp32s3_cpu1_reset_on_cpu,
+                         RUN_ON_CPU_HOST_PTR(s));
+    }
+}
+
+static bool esp32s3_diag_cpu1_held(Object *obj, Error **errp)
+{
+    return ESP32S3_SOC(obj)->cpu1_held_state;
+}
+
+static bool esp32s3_diag_cpu1_runstall(Object *obj, Error **errp)
+{
+    return ESP32S3_SOC(obj)->cpu1_runstall_raw;
+}
+
+static bool esp32s3_diag_cpu1_rtc_stall(Object *obj, Error **errp)
+{
+    return ESP32S3_SOC(obj)->rtc_cntl.cpu_stall_state[1];
+}
+
+static bool esp32s3_diag_cpu1_stalled(Object *obj, Error **errp)
+{
+    return ESP32S3_SOC(obj)->cpu1_stalled;
+}
+
+static bool esp32s3_diag_cpu1_halt_pending(Object *obj, Error **errp)
+{
+    return (CPU(&ESP32S3_SOC(obj)->cpu[1])->interrupt_request &
+            CPU_INTERRUPT_HALT) != 0;
+}
+
+static bool esp32s3_diag_cpu1_halted(Object *obj, Error **errp)
+{
+    return CPU(&ESP32S3_SOC(obj)->cpu[1])->halted;
+}
+
 static void esp32s3_soc_update_clocks(Esp32s3SocState *s);
 
 static void esp32s3_soc_reset(DeviceState *dev)
@@ -261,6 +356,7 @@ static void esp32s3_soc_reset(DeviceState *dev)
         xtensa_select_static_vectors(&s->cpu[1].env, s->rtc_cntl.stat_vector_sel[1]);
         remove_cpu_watchpoints(&s->cpu[1]);
         cpu_reset(CPU(&s->cpu[1]));
+        esp32s3_cpu1_update_stall(s);
     }
     /* Re-derive the clock outputs from the preserved RTC_CNTL state: the
      * BBPLL/RC_FAST power bits survive this reset, so the pll and rc-fast
@@ -291,6 +387,16 @@ bool esp32s3_reset_covers_rtc(const DeviceState *soc)
 
 static void esp32s3_cpu_stall(void* opaque, int n, int level)
 {
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+
+    if (n == 1) {
+        esp32s3_cpu1_update_stall(s);
+    } else if ((level != 0) != s->cpu[0].env.runstall) {
+        if (!level) {
+            cpu_reset_interrupt(CPU(&s->cpu[0]), CPU_INTERRUPT_HALT);
+        }
+        xtensa_runstall(&s->cpu[0].env, level != 0);
+    }
 }
 
 /* Recompute and propagate the whole ESP32-S3 clock tree from the SYSTEM
@@ -510,7 +616,9 @@ static void esp32s3_soc_realize(DeviceState *dev, Error **errp)
         }
         for (int i = 0; i < ms->smp.cpus; ++i) {
             qdev_connect_clock_in(DEVICE(&s->cpu[i]), "clk-in",
-                                  qdev_get_clock_out(clk_dev, "cpu-clk"));
+                                  qdev_get_clock_out(clk_dev,
+                                                     i == 1 ? "cpu1-clk" :
+                                                              "cpu-clk"));
         }
         /* RTC_CNTL derives the XTAL/2 RTC_FAST_CLK rate from the XTAL clock */
         qdev_connect_clock_in(DEVICE(&s->rtc_cntl), "xtal-clk",
@@ -704,6 +812,27 @@ static void esp32s3_soc_init(Object *obj)
     qdev_init_gpio_in_named(DEVICE(s), esp32s3_clk_update, ESP32S3_RTC_CLK_UPDATE_GPIO, 1);
     qdev_init_gpio_in_named(DEVICE(s), esp32s3_periph_rst_req, ESP32S3_CLK_RST_GPIO,
                             ESP32S3_RST_COUNT);
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_cpu1_control,
+                            ESP32S3_CLK_CPU1_HELD_GPIO, 1);
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_cpu1_control,
+                            ESP32S3_CLK_CPU1_RUNSTALL_GPIO, 1);
+    qdev_init_gpio_in_named(DEVICE(s), esp32s3_cpu1_reset_req,
+                            ESP32S3_CLK_CPU1_RESET_GPIO, 1);
+
+    object_property_add_bool(obj, "diag-cpu1-held",
+                             esp32s3_diag_cpu1_held, NULL);
+    object_property_add_bool(obj, "diag-cpu1-runstall-raw",
+                             esp32s3_diag_cpu1_runstall, NULL);
+    object_property_add_bool(obj, "diag-rtc-cpu1-stall",
+                             esp32s3_diag_cpu1_rtc_stall, NULL);
+    object_property_add_bool(obj, "diag-cpu1-stalled",
+                             esp32s3_diag_cpu1_stalled, NULL);
+    object_property_add_uint64_ptr(obj, "diag-cpu1-reset-count",
+                                  &s->cpu1_reset_count, OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "diag-cpu1-halt-pending",
+                             esp32s3_diag_cpu1_halt_pending, NULL);
+    object_property_add_bool(obj, "diag-cpu1-halted",
+                             esp32s3_diag_cpu1_halted, NULL);
 
     object_initialize_child(obj, "twai", &s->twai, TYPE_ESP32S3_TWAI);
 
@@ -861,6 +990,19 @@ static void esp32s3_machine_init(MachineState *machine)
                                                                ESP32S3_CLK_RST_GPIO, i));
         }
 
+        /* 0015: CPU1 lifecycle lines */
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_CPU1_HELD_GPIO, 0,
+                                    qdev_get_gpio_in_named(DEVICE(ss),
+                                                           "cpu1-held", 0));
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_CPU1_RUNSTALL_GPIO, 0,
+                                    qdev_get_gpio_in_named(DEVICE(ss),
+                                                           "cpu1-runstall", 0));
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_CPU1_RESET_GPIO, 0,
+                                    qdev_get_gpio_in_named(DEVICE(ss),
+                                                           "cpu1-reset", 0));
+        /* Earlier reset delivery predates these GPIO connections. */
+        esp32s3_clk_publish_cpu1_control(&ss->clock);
+
         /* Propagate the power-on clock tree through all the connections */
         esp32s3_soc_update_clocks(ss);
     }
diff --git a/hw/xtensa/esp32s3_clk.c b/hw/xtensa/esp32s3_clk.c
index 5425d76..8d43c8b 100644
--- a/hw/xtensa/esp32s3_clk.c
+++ b/hw/xtensa/esp32s3_clk.c
@@ -43,6 +43,15 @@
  * esp_system/port/soc/esp32s3/clk.c "assert(rtc_clk_xtal_freq_get() == 40M)").
  */
 
+static void esp32s3_clk_update_cpu1(ESP32S3ClockState *s)
+{
+    const bool enabled =
+        FIELD_EX32(s->core1_control0, SYSTEM_CORE_1_CONTROL_0_REG, CLKGATE_EN);
+
+    /* A separate physical gate, not an APB clock alias or a zeroed counter. */
+    clock_update(s->out_cpu1, enabled ? clock_get(s->out_cpu) : 0);
+}
+
 void esp32s3_clk_recompute_system(ESP32S3ClockState *s)
 {
     const uint32_t xtal_hz =
@@ -78,6 +87,7 @@ void esp32s3_clk_recompute_system(ESP32S3ClockState *s)
     }
 
     clock_update_hz(s->out_cpu, cpu_hz);
+    esp32s3_clk_update_cpu1(s);
     /* APB_CLK: 80 MHz from PLL_CLK, otherwise equal to CPU_CLK */
     clock_update_hz(s->out_apb,
                     soc_clk_sel == ESP32S3_CLK_SEL_PLL ? 80000000 : cpu_hz);
@@ -348,12 +358,36 @@ static uint32_t esp32s3_clock_get_ext_dev_enc_dec_ctrl(ESP32S3ClockState *s)
     return s->sys_ext_dev_enc_dec_ctrl;
 }
 
+void esp32s3_clk_publish_cpu1_control(ESP32S3ClockState *s)
+{
+    const bool enabled =
+        FIELD_EX32(s->core1_control0, SYSTEM_CORE_1_CONTROL_0_REG, CLKGATE_EN);
+
+    /* Release only after the real clock has resumed. Conversely, stop
+     * execution before suspending CCOUNT and compare-timer clock edges. */
+    if (enabled) {
+        esp32s3_clk_update_cpu1(s);
+    }
+    qemu_set_irq(s->cpu1_held_irq,
+                 FIELD_EX32(s->core1_control0, SYSTEM_CORE_1_CONTROL_0_REG,
+                            RESETING) || !enabled);
+    qemu_set_irq(s->cpu1_runstall_irq,
+                 FIELD_EX32(s->core1_control0, SYSTEM_CORE_1_CONTROL_0_REG,
+                            RUNSTALL));
+    if (!enabled) {
+        esp32s3_clk_update_cpu1(s);
+    }
+}
+
 static uint64_t esp32s3_clock_read(void *opaque, hwaddr addr, unsigned int size)
 {
     ESP32S3ClockState *s = ESP32S3_CLOCK(opaque);
     uint64_t r = 0;
 
     switch(addr) {
+        case A_SYSTEM_CORE_1_CONTROL_0_REG:
+                r = s->core1_control0;
+            break;
         case A_SYSTEM_CORE_1_CONTROL_1_REG:
                 r = s->app_cpu_addr;
             break;
@@ -405,6 +439,21 @@ static void esp32s3_clock_write(void *opaque, hwaddr addr, uint64_t value,
     ESP32S3ClockState *s = ESP32S3_CLOCK(opaque);
 
     switch(addr) {
+        case A_SYSTEM_CORE_1_CONTROL_0_REG: {
+            const uint32_t old = s->core1_control0;
+            const uint32_t reset =
+                R_SYSTEM_CORE_1_CONTROL_0_REG_RESETING_MASK;
+
+            s->core1_control0 = value &
+                (reset | R_SYSTEM_CORE_1_CONTROL_0_REG_CLKGATE_EN_MASK |
+                 R_SYSTEM_CORE_1_CONTROL_0_REG_RUNSTALL_MASK);
+            /* Publish the new hold before queuing a CPU-only reset. */
+            esp32s3_clk_publish_cpu1_control(s);
+            if ((s->core1_control0 & reset) && !(old & reset)) {
+                qemu_irq_pulse(s->cpu1_reset_irq);
+            }
+            break;
+        }
         case A_SYSTEM_CORE_1_CONTROL_1_REG:
                 s->app_cpu_addr = (uint32_t)value;
             break;
@@ -505,6 +554,10 @@ static void esp32s3_clock_reset_hold(Object *obj, ResetType type)
                 (ESP32S3_CLK_SEL_XTAL << R_SYSTEM_SYSCLK_CONF_SOC_CLK_SEL_SHIFT) |
                 (40 << R_SYSTEM_SYSCLK_CONF_CLK_XTAL_FREQ_SHIFT);
     s->pll_valid = true;         /* BBPLL_FORCE_PD resets to 0 = powered */
+    /* TRM v1.8 Register 17.1: reset asserted, clock gate disabled. */
+    s->core1_control0 = R_SYSTEM_CORE_1_CONTROL_0_REG_RESETING_MASK;
+    s->app_cpu_addr = 0;
+    esp32s3_clk_publish_cpu1_control(s);
 
     /* Divider for PLL clock and APB  frequency */
     s->cpuperconf = (ESP32S3_PERIOD_SEL_80 << R_SYSTEM_CPU_PER_CONF_CPUPERIOD_SEL_SHIFT) |
@@ -576,6 +629,7 @@ static void esp32s3_clock_init(Object *obj)
 
     /* Clock tree outputs (consumers are wired by the SoC) */
     s->out_cpu = qdev_init_clock_out(DEVICE(obj), "cpu-clk");
+    s->out_cpu1 = qdev_init_clock_out(DEVICE(obj), "cpu1-clk");
     s->out_apb = qdev_init_clock_out(DEVICE(obj), "apb-clk");
     s->out_xtal = qdev_init_clock_out(DEVICE(obj), "xtal-clk");
     s->out_rtc_slow = qdev_init_clock_out(DEVICE(obj), "rtc-slow-clk");
@@ -592,6 +646,12 @@ static void esp32s3_clock_init(Object *obj)
                              ESP32S3_RST_COUNT);
     qdev_init_gpio_out_named(DEVICE(obj), s->rst_level_irqs,
                              ESP32S3_CLK_RST_LEVEL_GPIO, ESP32S3_RST_COUNT);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->cpu1_held_irq,
+                             ESP32S3_CLK_CPU1_HELD_GPIO, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->cpu1_runstall_irq,
+                             ESP32S3_CLK_CPU1_RUNSTALL_GPIO, 1);
+    qdev_init_gpio_out_named(DEVICE(obj), &s->cpu1_reset_irq,
+                             ESP32S3_CLK_CPU1_RESET_GPIO, 1);
 
     /* Initialize the output IRQ lines used to manually trigger interrupts */
     for (uint64_t i = 0; i < ESP32S3_SYSTEM_CPU_INTR_COUNT; i++) {
diff --git a/hw/xtensa/pic_cpu.c b/hw/xtensa/pic_cpu.c
