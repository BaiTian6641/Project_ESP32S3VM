     DeviceState *soc_reset;
@@ -232,3 +242,6 @@ void esp32s3_clk_set_rc_fast(ESP32S3ClockState *s, bool powered);
  */
 void esp32s3_clk_set_pll_valid(ESP32S3ClockState *s, bool valid);
 
