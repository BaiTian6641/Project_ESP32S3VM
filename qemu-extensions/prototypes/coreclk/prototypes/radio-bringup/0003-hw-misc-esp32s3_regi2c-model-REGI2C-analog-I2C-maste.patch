diff --git a/hw/misc/esp32s3_regi2c.c b/hw/misc/esp32s3_regi2c.c
new file mode 100644
index 0000000..02577ad
--- /dev/null
+++ b/hw/misc/esp32s3_regi2c.c
@@ -0,0 +1,753 @@
+/*
+ * ESP32-S3 REGI2C / I2C_MST analog master + SAR2/PWDET sequencer
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * MATURITY: SEQUENCING-ONLY, FAIL-CLOSED (rev B).
+ *
+ * The analog I2C master block at 0x6000E000-0x6000E0FF is undocumented for
+ * ESP32-S3 (no TRM chapter, absent from the official memory map). This model
+ * implements the transaction SURFACE evidenced from the rev0 ROM
+ * (esp32s3_rev0_rom.elf, esp-rom-elfs 20241011,
+ * sha256 c0ce0f338d1de1bdc6efbef1591779a2a42c1ab7d759d3c6ae8ae63a7dd34cfd)
+ * and MMIO write traces of unmodified Wi-Fi/BLE calibration runs:
+ *
+ *   rom_i2c_paral_write  0x40035684 / rom_i2c_paral_read 0x40035614
+ *     - two parallel engine transaction words at +0x00 and +0x04:
+ *       [7:0] slave, [15:8] reg, [23:16] data, BIT24 = write/start,
+ *       BIT25 = BUSY (RO, self-clearing), [27:26] func id (0 and 1 seen).
+ *   rom_chip_i2c_readReg_org 0x400354fc: same encoding through +0x00.
+ *   rom_i2c_paral_set_read 0x400355d8 / rom_i2c_paral_set_mst0 0x40035594 /
+ *   rom_get_i2c_hostid 0x400354bc: RMW of +0x44 / +0x48 (public names in
+ *     regi2c_defs.h).
+ *   rom_i2cmst_reg_init 0x400389f0: programs +0x40, +0x50, +0x54, +0x58,
+ *     +0x5c, +0x60, +0xc4 (observed values 0x0f0f / 100 / 0xff0000 / 0xaaaa
+ *     / 0x08 on the bring-up trace).
+ *   rom_pwdet_sar2_init 0x40036470 / rom_pkdet_vol_start 0x40036a18 /
+ *   rom_read_sar_dout 0x40036aa4: the SAR2/PWDT flow -- +0x5c BIT23 start
+ *     (armed by the SENS force pair), poll +0x50[26:24] == 7, +0x50 BIT1
+ *     toggle, 8x13-bit codes from +0x80..+0x9c.
+ *   Blob txdc_cal_v70 (libphy.a): command word +0x4c, poll BIT24.
+ *   temperature_sensor_ll.h: SENS_SAR_TCTRL 0x60008850 dump_out/ready/out.
+ *
+ * FAIL-CLOSED CONTRACT
+ * --------------------
+ * Timing and status are derived from modeled engine state (never constants).
+ * MEASUREMENT DATA is NOT modeled: SAR2 result words, TSENS samples and
+ * TX-DC done/flags require a configured measurement provider (QOM link
+ * "meas-provider", interface TYPE_ESP32S3_REGI2C_MEAS_PROVIDER). Without a
+ * provider the device FAILS CLOSED at the moment such data would be handed
+ * to firmware: it never presents DONE-with-data, never latches filler
+ * values, reports the exact unavailable dependency and pauses the VM
+ * (bottom half + vm_stop(RUN_STATE_PAUSED), never from inside a timerlist
+ * run; resume only via explicit user action). A provider returning real
+ * (e.g. hardware-captured) samples permits completion; its absence must
+ * remain unavailable.
+ *
+ * ANALOG I2C SLAVE REGISTER FILE (config storage, NOT measurement data):
+ * the ROM grammar is read-modify-write everywhere (rom_chip_i2c_readReg /
+ * rom_i2c_readReg_Mask consumers), so engine reads return the addressed
+ * slave register's stored state -- writes latch the data byte, reset
+ * defaults are UNKNOWN and modeled as 0, and reads of never-written pairs
+ * are diagnosed once. This models the slaves' own config storage (e.g.
+ * slave 0x69 = I2C_SAR_ADC DTEST/ENT_TSENS/ENCAL_REF bits, slave 0x67 =
+ * BBPLL config), which the bootloader RMWs during early boot; it does not
+ * fabricate measurement results.
+ *
+ * Exploratory fail-open runs (rev A, zeros latched with UNKNOWN logging) are
+ * preserved UNQUALIFIED under build-runtime-state/regi2c-2026-10-07/
+ * exploratory/ and must not be used as behavioral evidence of the model.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "sysemu/runstate.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32s3_regi2c.h"
+
+#include "hw/misc/esp32s3_regi2c_defs.h"
+
+#define REGI2C_DEBUG   0
+#define REGI2C_WARNING 0
+
+/* Modeled clocks and derived timing.
+ *
+ * I2C SCL: derived from the +0x58 low byte (ROM programs 100, observed
+ * trace; true field semantics UNKNOWN). APB 80 MHz / 100 = 800 kHz. A
+ * 3-byte I2C transaction (start + addr/ack + reg/ack + data/ack + stop) is
+ * 37 bits on the wire.
+ *
+ * SAR2 conversion: 8 samples x 32 SAR cycles at a modeled 2 MHz SAR clock.
+ * TSENS: 32 cycles x (clk_div + 1) at a modeled 1 MHz tsens clock. All
+ * base clocks UNKNOWN; durations are bounded sequencing placeholders only
+ * (data production is fail-closed regardless of duration). */
+#define REGI2C_APB_CLK_HZ        80000000ull
+#define REGI2C_I2C_BITS_XFER     37u
+#define REGI2C_I2C_DIV_DEFAULT   100u
+#define REGI2C_SAR_CLK_HZ        2000000ull
+#define REGI2C_SAR_CYCLES_SAMPLE 32u
+#define REGI2C_SAR2_SAMPLES      8u
+#define REGI2C_TSENS_CLK_HZ      1000000ull
+#define REGI2C_TSENS_CYCLES      32u
+
+#define R_IDX(a) ((a) / 4)
+
+static uint64_t esp32s3_regi2c_engine_duration_ns(ESP32S3RegI2CState *s)
+{
+    uint32_t div = FIELD_EX32(s->regs[R_IDX(A_REGI2C_MST_CFG1)],
+                              REGI2C_MST_CFG1, DIV);
+    uint64_t scl_hz;
+
+    if (div == 0) {
+        div = REGI2C_I2C_DIV_DEFAULT;
+    }
+    scl_hz = REGI2C_APB_CLK_HZ / div;
+    return (uint64_t)REGI2C_I2C_BITS_XFER * 1000000000ull / scl_hz;
+}
+
+static uint64_t esp32s3_regi2c_sar2_duration_ns(void)
+{
+    return (uint64_t)REGI2C_SAR2_SAMPLES * REGI2C_SAR_CYCLES_SAMPLE *
+           1000000000ull / REGI2C_SAR_CLK_HZ;
+}
+
+/* Fail-closed: report the exact unavailable dependency once and pause the
+ * VM from a bottom half (never from inside a timerlist run -- see the
+ * hostbus probe pattern). The dependency stays paused; an explicit external
+ * "cont" is required to resume, and consumption fails again immediately
+ * unless a measurement provider is attached. */
+static void esp32s3_regi2c_pause_bh(void *opaque)
+{
+    if (!runstate_is_running()) {
+        return; /* already paused by us or someone else */
+    }
+    if (vm_stop(RUN_STATE_PAUSED) < 0) {
+        error_report("esp32s3.regi2c: unable to pause VM on unavailable "
+                     "measurement dependency");
+    }
+}
+
+static void G_GNUC_PRINTF(2, 3)
+esp32s3_regi2c_unavailable(ESP32S3RegI2CState *s, const char *fmt, ...)
+{
+    va_list ap;
+    char detail[192];
+
+    if (s->unavailable) {
+        qemu_bh_schedule(s->pause_bh);
+        return;
+    }
+    s->unavailable = true;
+
+    va_start(ap, fmt);
+    vsnprintf(detail, sizeof(detail), fmt, ap);
+    va_end(ap);
+    error_report("esp32s3.regi2c: measurement/data dependency unavailable, "
+                 "failing closed BEFORE firmware consumption: %s -- attach "
+                 "a measurement provider (QOM link \"meas-provider\", "
+                 "interface %s) with real samples; VM paused, explicit "
+                 "resume required", detail,
+                 TYPE_ESP32S3_REGI2C_MEAS_PROVIDER);
+    qemu_bh_schedule(s->pause_bh);
+}
+
+static void esp32s3_regi2c_sar2_set_phase(ESP32S3RegI2CState *s,
+                                          Esp32s3RegI2CSar2Phase phase,
+                                          int64_t duration_ns)
+{
+    static const uint32_t phase_status[] = {
+        [REGI2C_SAR2_IDLE] = REGI2C_SAR2_STATUS_IDLE,
+        [REGI2C_SAR2_CMD] = 1u << 24,
+        [REGI2C_SAR2_SAMPLING] = 2u << 24,
+    };
+
+    s->sar2_phase = phase;
+    s->regs[R_IDX(A_REGI2C_SAR2_STATUS)] &= ~REGI2C_SAR2_STATUS_MASK;
+    s->regs[R_IDX(A_REGI2C_SAR2_STATUS)] |= phase_status[phase];
+    if (phase != REGI2C_SAR2_IDLE) {
+        timer_mod(s->sar2_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                                 duration_ns);
+    }
+}
+
+/* Start one sequenced SAR2/PWDET measurement cycle. Requires the SENS SAR2
+ * RTC force arming written by rom_pwdet_sar2_init: SENS_SAR_MEAS2_CTRL2
+ * SENS_SAR2_EN_PAD_FORCE (BIT31) set and SENS_SAR_MEAS2_MUX
+ * SENS_SAR2_RTC_FORCE (BIT31) clear. Without arming the trigger is ignored
+ * (sequencer stays idle) -- conservative: never fake progress. */
+static void esp32s3_regi2c_sar2_start(ESP32S3RegI2CState *s)
+{
+    if (s->sar2_phase != REGI2C_SAR2_IDLE) {
+        return; /* cycle already in flight */
+    }
+    if (!(s->sens_ctrl2 & SENS_SAR_MEAS2_CTRL2_EN_PAD_FORCE) ||
+        (s->sens_mux & SENS_SAR_MEAS2_MUX_RTC_FORCE)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.regi2c: SAR2 start ignored: RTC path not "
+                      "armed (SENS_SAR_MEAS2_CTRL2=0x%08x "
+                      "SENS_SAR_MEAS2_MUX=0x%08x)\n",
+                      s->sens_ctrl2, s->sens_mux);
+        return; /* SAR2 RTC path not armed: no conversion, no progress */
+    }
+
+    s->sar2_conv_count++;
+    /* Phase 1: the REGI2C master serializes the SAR2 config transaction
+     * (slave/reg from +0x5c[15:0]) at the divider-derived SCL. */
+    esp32s3_regi2c_sar2_set_phase(s, REGI2C_SAR2_CMD,
+                                  esp32s3_regi2c_engine_duration_ns(s));
+}
+
+static void esp32s3_regi2c_sar2_advance(void *opaque)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+    Esp32s3RegI2cMeasProviderInterface *p = NULL;
+    int i;
+
+    switch (s->sar2_phase) {
+    case REGI2C_SAR2_CMD:
+        /* Phase 2: 8 SAR2 conversions filling the result FIFO window. */
+        esp32s3_regi2c_sar2_set_phase(s, REGI2C_SAR2_SAMPLING,
+                                      esp32s3_regi2c_sar2_duration_ns());
+        break;
+    case REGI2C_SAR2_SAMPLING:
+        /* Conversion window elapsed. Results require a real measurement
+         * provider; without one the sequencer NEVER completes and the VM
+         * pauses before firmware could consume anything. */
+        if (s->meas_provider) {
+            p = ESP32S3_REGI2C_MEAS_PROVIDER_GET_CLASS(s->meas_provider);
+        }
+        if (!p || !p->sar2_word) {
+            esp32s3_regi2c_unavailable(s,
+                "SAR2/PWDT conversion #%u results (FIFO +0x80..+0x9c, "
+                "8x13-bit codes consumed by rom_read_sar_dout/"
+                "rom_read_sar2_code); real PWDET sampling semantics "
+                "unknown", s->sar2_conv_count);
+            return; /* sequencer stops in SAMPLING; VM pauses */
+        }
+        for (i = 0; i < REGI2C_SAR2_SAMPLES; i++) {
+            uint32_t value;
+            if (!p->sar2_word(s->meas_provider, s->sar2_conv_count, i,
+                              &value)) {
+                esp32s3_regi2c_unavailable(s,
+                    "SAR2/PWDT conversion #%u word %u not provided by "
+                    "measurement provider", s->sar2_conv_count, i);
+                return;
+            }
+            s->regs[R_IDX(A_REGI2C_SAR2_DATA0) + i] = value & 0x1fff;
+        }
+        esp32s3_regi2c_sar2_set_phase(s, REGI2C_SAR2_IDLE, 0);
+        break;
+    default:
+        esp32s3_regi2c_sar2_set_phase(s, REGI2C_SAR2_IDLE, 0);
+        break;
+    }
+}
+
+static void esp32s3_regi2c_txdc_done(void *opaque)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+    Esp32s3RegI2cMeasProviderInterface *p = NULL;
+
+    /* The DONE bit reports completion of an analog-side measurement whose
+     * direction flags (BIT30/BIT31) the blob consumes -- no provider, no
+     * completion. */
+    if (s->meas_provider) {
+        p = ESP32S3_REGI2C_MEAS_PROVIDER_GET_CLASS(s->meas_provider);
+    }
+    if (!p || !p->op_done ||
+        !p->op_done(s->meas_provider, REGI2C_OP_TXDC,
+                    s->regs[R_IDX(A_REGI2C_TXDC_STATUS)])) {
+        esp32s3_regi2c_unavailable(s,
+            "TX-DC calibration operation (+0x4c cmd=0x%08x, polled DONE/"
+            "direction flags consumed by txdc_cal_v70); flag semantics "
+            "unknown",
+            s->regs[R_IDX(A_REGI2C_TXDC_STATUS)]);
+        return; /* DONE never set */
+    }
+    s->regs[R_IDX(A_REGI2C_TXDC_STATUS)] |= REGI2C_TXDC_DONE;
+}
+
+static void esp32s3_regi2c_engine_done(void *opaque)
+{
+    Esp32s3RegI2CEngine *e = opaque;
+    ESP32S3RegI2CState *s = e->parent;
+    uint32_t word = s->regs[e->index];
+
+    word &= ~REGI2C_ENG_BUSY;
+    if (word & REGI2C_ENG_START) {
+        /* Write transaction: latch the data byte into the analog slave's
+         * register file (config storage; read-back feeds the ROM's RMW
+         * pattern). */
+        s->slave_regs[REGI2C_ENG_SLAVE_OF(word)][REGI2C_ENG_REG_OF(word)] =
+            (uint8_t)REGI2C_ENG_DATA_OF(word);
+        s->slave_written[REGI2C_ENG_SLAVE_OF(word)][REGI2C_ENG_REG_OF(word) / 8] |=
+            1u << (REGI2C_ENG_REG_OF(word) % 8);
+    } else {
+        /* Read transaction: the result byte [23:16] is the analog slave's
+         * register value. The ROM grammar is read-modify-write everywhere
+         * (rom_chip_i2c_readReg_org / rom_i2c_readReg_Mask consumers), so
+         * reads return the slave register file's stored state (reset
+         * default 0, UNKNOWN). Reads of never-written pairs are diagnosed
+         * once. Measurement data is NOT served from here: SAR2/TSENS/
+         * TX-DC stay behind the measurement provider. A provider, when
+         * attached, overrides the stored state. */
+        uint8_t slave = REGI2C_ENG_SLAVE_OF(word);
+        uint8_t reg = REGI2C_ENG_REG_OF(word);
+        Esp32s3RegI2cMeasProviderInterface *p = NULL;
+        uint8_t value;
+
+        if (s->meas_provider) {
+            p = ESP32S3_REGI2C_MEAS_PROVIDER_GET_CLASS(s->meas_provider);
+        }
+        if (p && p->engine_read_byte) {
+            if (!p->engine_read_byte(s->meas_provider, slave, reg,
+                                     &value)) {
+                esp32s3_regi2c_unavailable(s,
+                    "analog I2C read (engine %d, word 0x%08x: slave "
+                    "0x%02x reg 0x%02x): provider has no sample",
+                    e->index, word, slave, reg);
+                s->regs[e->index] = word & ~REGI2C_ENG_BUSY;
+                return;
+            }
+        } else {
+            value = s->slave_regs[slave][reg];
+            if (!(s->slave_written[slave][reg / 8] & (1u << (reg % 8)))) {
+                qemu_log_mask(LOG_UNIMP,
+                              "esp32s3.regi2c: read of never-written "
+                              "analog slave register (slave 0x%02x reg "
+                              "0x%02x) -- returning reset state 0 "
+                              "(reset defaults UNKNOWN)\n", slave, reg);
+            }
+        }
+        word &= ~REGI2C_ENG_DATA;
+        word |= (uint32_t)value << 16;
+    }
+    s->regs[e->index] = word;
+}
+static void esp32s3_regi2c_engine_write(ESP32S3RegI2CState *s, int idx,
+                                        uint32_t value)
+{
+    Esp32s3RegI2CEngine *e = &s->eng[idx];
+    uint32_t word = value;
+    uint32_t func = FIELD_EX32(word, REGI2C_ENG, FUNC);
+
+    if (word & REGI2C_ENG_BUSY) {
+        /* BUSY is engine-owned (RO on silicon evidence); software writes
+         * setting it are unsupported. */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.regi2c: engine %d: unsupported write with "
+                      "BUSY set: 0x%08x (ignored)\n", idx, word);
+        return;
+    }
+    if (func > 1) {
+        /* Evidenced func ids are 0 and 1 (baseline trace: rom_i2c_paral_*
+         * words carry func 1, direct phy-lib words like 0x011b016b carry
+         * func 0). Ids 2/3 have never been observed. */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.regi2c: engine %d: unsupported func id %u "
+                      "in word 0x%08x (ignored)\n", idx, func, word);
+        return;
+    }
+
+    if (word & (REGI2C_ENG_START | REGI2C_ENG_FUNC_MASK)) {
+        /* Transaction start (write or read shape): BUSY self-clears after
+         * the modeled wire time. */
+        word |= REGI2C_ENG_BUSY;
+        s->regs[idx] = word;
+        timer_mod(e->timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  esp32s3_regi2c_engine_duration_ns(s));
+        return;
+    }
+    s->regs[idx] = word;
+}
+
+static bool esp32s3_regi2c_is_evidenced(uint32_t idx)
+{
+    switch (idx) {
+    case R_IDX(A_REGI2C_ENG0_WORD):
+    case R_IDX(A_REGI2C_ENG1_WORD):
+    case R_IDX(A_REGI2C_ANA_CONF0):
+    case R_IDX(A_REGI2C_ANA_CONFIG):
+    case R_IDX(A_REGI2C_ANA_CONFIG2):
+    case R_IDX(A_REGI2C_TXDC_STATUS):
+    case R_IDX(A_REGI2C_SAR2_STATUS):
+    case R_IDX(A_REGI2C_MST_CFG0):
+    case R_IDX(A_REGI2C_MST_CFG1):
+    case R_IDX(A_REGI2C_SAR2_CFG):
+    case R_IDX(A_REGI2C_SAR2_CFG2):
+    case R_IDX(A_REGI2C_UNK_CFG):
+        return true;
+    default:
+        return idx >= R_IDX(A_REGI2C_SAR2_DATA0) &&
+               idx < R_IDX(A_REGI2C_SAR2_DATA0) + REGI2C_SAR2_SAMPLES;
+    }
+}
+
+static uint64_t esp32s3_regi2c_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+    uint32_t idx = addr / 4;
+    uint64_t r = 0;
+
+    if (addr >= ESP32S3_REGI2C_REG_SIZE || (addr % 4) != 0) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.regi2c: unaligned/out-of-range read 0x%03x\n",
+                      (unsigned)addr);
+        return 0;
+    }
+
+    switch (addr) {
+    case A_REGI2C_SAR2_STATUS:
+        /* [26:24] reflects the current sequencer phase, updated at phase
+         * transitions (idle 7; CMD/SAMPLING encodings UNKNOWN). */
+        r = s->regs[idx];
+        break;
+    default:
+        r = s->regs[idx];
+        break;
+    }
+
+    if (!esp32s3_regi2c_is_evidenced(idx)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32s3.regi2c: read of non-evidenced register "
+                      "0x%02x\n", (unsigned)addr);
+    }
+#if REGI2C_DEBUG
+    info_report("[REGI2C] read 0x%02x -> 0x%08x", (unsigned)addr,
+                (unsigned)r);
+#endif
+    return r;
+}
+
+static void esp32s3_regi2c_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+    uint32_t idx = addr / 4;
+
+    if (addr >= ESP32S3_REGI2C_REG_SIZE || (addr % 4) != 0) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.regi2c: unaligned/out-of-range write 0x%03x "
+                      "<= 0x%08llx\n", (unsigned)addr,
+                      (unsigned long long)value);
+        return;
+    }
+
+#if REGI2C_DEBUG
+    info_report("[REGI2C] write 0x%02x <= 0x%08x", (unsigned)addr,
+                (unsigned)value);
+#endif
+
+    switch (addr) {
+    case A_REGI2C_ENG0_WORD:
+    case A_REGI2C_ENG1_WORD:
+        esp32s3_regi2c_engine_write(s, addr / 4, (uint32_t)value);
+        return;
+    case A_REGI2C_SAR2_CFG: {
+        uint32_t old = s->regs[idx];
+
+        s->regs[idx] = (uint32_t)value;
+        /* Rising edge of the start bit (BIT23) begins a timed conversion.
+         * This is the rom_pkdet_vol_start trigger; UNKNOWN whether silicon
+         * also treats BIT19 as a mode selector (stored only). */
+        if (!(old & REGI2C_SAR2_CFG_START) &&
+            (value & REGI2C_SAR2_CFG_START)) {
+            esp32s3_regi2c_sar2_start(s);
+        }
+        return;
+    }
+    case A_REGI2C_SAR2_STATUS:
+        s->regs[idx] = (uint32_t)value;
+        /* Rising edge of BIT1 re-runs the sequencer (rom_pkdet_vol_start
+         * toggles it between its two polls). UNKNOWN true semantics;
+         * conservative stateful choice, not a completion constant. */
+        if (value & 0x2) {
+            esp32s3_regi2c_sar2_start(s);
+        }
+        return;
+    case A_REGI2C_TXDC_STATUS:
+        s->regs[idx] = (uint32_t)value & ~REGI2C_TXDC_DONE;
+        if (value & REGI2C_TXDC_CMD_START) {
+            /* Command write starts a bounded analog-side operation whose
+             * completion (DONE + direction flags) requires a measurement
+             * provider; see esp32s3_regi2c_txdc_done. */
+            timer_mod(s->txdc_timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                      esp32s3_regi2c_engine_duration_ns(s));
+        }
+        return;
+    default:
+        s->regs[idx] = (uint32_t)value;
+        break;
+    }
+
+    if (!esp32s3_regi2c_is_evidenced(idx)) {
+        qemu_log_mask(LOG_UNIMP,
+                      "esp32s3.regi2c: write to non-evidenced register "
+                      "0x%02x <= 0x%08x\n", (unsigned)addr,
+                      (unsigned)value);
+    }
+}
+
+static const MemoryRegionOps esp32s3_regi2c_ops = {
+    .read = esp32s3_regi2c_read,
+    .write = esp32s3_regi2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+/* Minimal SENS SAR2 RTC-force surface (0x60008830/0x60008834).
+ *
+ * Only these two SENS offsets are evidenced in the calibration path
+ * (rom_pwdet_sar2_init; sens_reg.h SENS_SAR_MEAS2_CTRL2_REG /
+ * SENS_SAR_MEAS2_MUX_REG). They gate the modeled SAR2 conversion (force
+ * enable set, RTC force clear). INTEGRATION NOTE: the final machine must
+ * have exactly ONE SENS owner; when the full SENS controller
+ * (0x60008800-0x600089FF) lands, these two words and the TCTRL region
+ * below move under it and this device consumes the agreed GPIO inputs
+ * ("sar2-armed", "tsens-dump-out") instead -- contract agreed with the
+ * ADC lane. */
+static uint64_t esp32s3_sens_sar2_read(void *opaque, hwaddr addr,
+                                       unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    switch (addr) {
+    case 0x0:
+        return s->sens_ctrl2;
+    case 0x4:
+        return s->sens_mux;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.sens_sar2: out-of-range read 0x%02x\n",
+                      (unsigned)addr);
+        return 0;
+    }
+}
+
+static void esp32s3_sens_sar2_write(void *opaque, hwaddr addr, uint64_t value,
+                                    unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    switch (addr) {
+    case 0x0:
+        s->sens_ctrl2 = (uint32_t)value;
+        return;
+    case 0x4:
+        s->sens_mux = (uint32_t)value;
+        return;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.sens_sar2: out-of-range write 0x%02x\n",
+                      (unsigned)addr);
+        return;
+    }
+}
+
+static const MemoryRegionOps esp32s3_sens_sar2_ops = {
+    .read = esp32s3_sens_sar2_read,
+    .write = esp32s3_sens_sar2_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+/* SENS_SAR_TCTRL (0x60008850): temperature sensor control/data.
+ *
+ * Evidenced by the fixture's temperature_sensor_ll_get_raw_value and the
+ * phy init writes traced at 0x60008850 (dump_out and power bits). Rising
+ * TSENS_DUMP_OUT starts a timed conversion; TSENS_READY/TSENS_OUT are only
+ * produced by a measurement provider -- without one the device fails
+ * closed before firmware consumes a value. */
+static void esp32s3_regi2c_tsens_done(void *opaque)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+    Esp32s3RegI2cMeasProviderInterface *p = NULL;
+    uint32_t value;
+
+    if (s->meas_provider) {
+        p = ESP32S3_REGI2C_MEAS_PROVIDER_GET_CLASS(s->meas_provider);
+    }
+    if (!p || !p->tsens_sample ||
+        !p->tsens_sample(s->meas_provider, &value)) {
+        esp32s3_regi2c_unavailable(s,
+            "TSENS sample (SENS_SAR_TCTRL tsens_out [7:0], consumed by "
+            "temperature_sensor_hal_get_raw_value); real tsens mapping "
+            "unknown");
+        return; /* READY never set, OUT never latched */
+    }
+    s->sens_tctrl = (s->sens_tctrl & ~SENS_TSENS_OUT) |
+                    (value & SENS_TSENS_OUT);
+    s->sens_tctrl |= SENS_TSENS_READY;
+}
+
+static void esp32s3_sens_tctrl_write(ESP32S3RegI2CState *s, uint32_t value)
+{
+    bool start = !(s->sens_tctrl & SENS_TSENS_DUMP_OUT) &&
+                 (value & SENS_TSENS_DUMP_OUT);
+    uint32_t div = FIELD_EX32(value, SENS_TSENS, CLK_DIV);
+
+    s->sens_tctrl = value & ~(SENS_TSENS_READY | SENS_TSENS_OUT);
+    if (start) {
+        s->sens_tctrl &= ~SENS_TSENS_READY;
+        timer_mod(s->tsens_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  (int64_t)REGI2C_TSENS_CYCLES * 1000000000ull *
+                  (div + 1) / REGI2C_TSENS_CLK_HZ);
+    }
+}
+
+static uint64_t esp32s3_sens_tctrl_read(void *opaque, hwaddr addr,
+                                        unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    if (addr != 0) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.sens_tctrl: out-of-range read 0x%02x\n",
+                      (unsigned)addr);
+        return 0;
+    }
+    return s->sens_tctrl;
+}
+
+static void esp32s3_sens_tctrl_mmio_write(void *opaque, hwaddr addr,
+                                          uint64_t value, unsigned int size)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(opaque);
+
+    if (addr != 0) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "esp32s3.sens_tctrl: out-of-range write 0x%02x\n",
+                      (unsigned)addr);
+        return;
+    }
+    esp32s3_sens_tctrl_write(s, (uint32_t)value);
+}
+
+static const MemoryRegionOps esp32s3_sens_tctrl_ops = {
+    .read = esp32s3_sens_tctrl_read,
+    .write = esp32s3_sens_tctrl_mmio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void esp32s3_regi2c_reset_hold(Object *obj, ResetType type)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+
+    /* +0x50[26:24] idles at 7 (nearest public descendant: ESP32-C6
+     * LP_I2C_ANA_MST I2C0_STATUS[31:24] power-on default 7). */
+    s->regs[R_IDX(A_REGI2C_SAR2_STATUS)] = REGI2C_SAR2_STATUS_IDLE;
+    /* +0x58 low byte divider: true reset value UNKNOWN; modeled as 100 to
+     * match the only observed value (rom_i2cmst_reg_init). */
+    s->regs[R_IDX(A_REGI2C_MST_CFG1)] = REGI2C_I2C_DIV_DEFAULT;
+
+    s->sens_ctrl2 = 0;
+    s->sens_mux = 0;
+    s->sens_tctrl = 0;
+    s->sar2_conv_count = 0;
+    s->sar2_phase = REGI2C_SAR2_IDLE;
+    s->unavailable = false;
+    memset(s->slave_regs, 0, sizeof(s->slave_regs));
+    memset(s->slave_written, 0, sizeof(s->slave_written));
+
+    timer_del(s->eng[0].timer);
+    timer_del(s->eng[1].timer);
+    timer_del(s->sar2_timer);
+    timer_del(s->txdc_timer);
+    timer_del(s->tsens_timer);
+}
+
+static void esp32s3_regi2c_realize(DeviceState *dev, Error **errp)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &esp32s3_regi2c_ops, s,
+                          "esp32s3.regi2c", ESP32S3_REGI2C_REG_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+
+    memory_region_init_io(&s->sens_iomem, OBJECT(s), &esp32s3_sens_sar2_ops, s,
+                          "esp32s3.sens_sar2", 0x8);
+    sysbus_init_mmio(sbd, &s->sens_iomem);
+
+    memory_region_init_io(&s->tctrl_iomem, OBJECT(s), &esp32s3_sens_tctrl_ops,
+                          s, "esp32s3.sens_tctrl", 0x4);
+    sysbus_init_mmio(sbd, &s->tctrl_iomem);
+}
+
+static void esp32s3_regi2c_init(Object *obj)
+{
+    ESP32S3RegI2CState *s = ESP32S3_REGI2C(obj);
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        s->eng[i].parent = s;
+        s->eng[i].index = i;
+        s->eng[i].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       esp32s3_regi2c_engine_done, &s->eng[i]);
+    }
+    s->sar2_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                 esp32s3_regi2c_sar2_advance, s);
+    s->txdc_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                 esp32s3_regi2c_txdc_done, s);
+    s->tsens_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                  esp32s3_regi2c_tsens_done, s);
+    s->pause_bh = qemu_bh_new(esp32s3_regi2c_pause_bh, s);
+
+    object_property_add_link(obj, "meas-provider",
+                             TYPE_ESP32S3_REGI2C_MEAS_PROVIDER,
+                             (Object **)&s->meas_provider,
+                             object_property_allow_set_link,
+                             OBJ_PROP_LINK_STRONG);
+}
+
+static void esp32s3_regi2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    rc->phases.hold = esp32s3_regi2c_reset_hold;
+    dc->realize = esp32s3_regi2c_realize;
+    dc->desc = "ESP32-S3 REGI2C analog I2C master + SAR2/PWDT sequencer "
+               "(sequencing-only, fail-closed)";
+}
+
+static const TypeInfo esp32s3_regi2c_info = {
+    .name = TYPE_ESP32S3_REGI2C,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(ESP32S3RegI2CState),
+    .instance_init = esp32s3_regi2c_init,
+    .class_init = esp32s3_regi2c_class_init,
+};
+
+static const TypeInfo esp32s3_regi2c_meas_provider_info = {
+    .name = TYPE_ESP32S3_REGI2C_MEAS_PROVIDER,
+    .parent = TYPE_INTERFACE,
+    .class_size = sizeof(Esp32s3RegI2cMeasProviderInterface),
+};
+
+static void esp32s3_regi2c_register_types(void)
+{
+    type_register_static(&esp32s3_regi2c_info);
+    type_register_static(&esp32s3_regi2c_meas_provider_info);
+}
+
+type_init(esp32s3_regi2c_register_types);
