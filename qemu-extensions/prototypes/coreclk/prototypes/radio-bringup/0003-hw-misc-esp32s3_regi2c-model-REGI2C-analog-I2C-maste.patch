diff --git a/include/hw/misc/esp32s3_regi2c.h b/include/hw/misc/esp32s3_regi2c.h
new file mode 100644
index 0000000..bb731bc
--- /dev/null
+++ b/include/hw/misc/esp32s3_regi2c.h
@@ -0,0 +1,112 @@
+/*
+ * ESP32-S3 REGI2C / I2C_MST analog master (undocumented block 0x6000E000)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * SEQUENCING-ONLY, FAIL-CLOSED model: transaction grammar and timed engine
+ * state are modeled; every measurement/data production requires a configured
+ * measurement provider (see Esp32s3RegI2cMeasProviderInterface). See
+ * hw/misc/esp32s3_regi2c.c for the evidence trail.
+ */
+#ifndef HW_MISC_ESP32S3_REGI2C_H
+#define HW_MISC_ESP32S3_REGI2C_H
+
+#include "qemu/main-loop.h"
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+#include "hw/misc/esp32s3_regi2c_defs.h"
+
+#define TYPE_ESP32S3_REGI2C "esp32s3.regi2c"
+OBJECT_DECLARE_SIMPLE_TYPE(ESP32S3RegI2CState, ESP32S3_REGI2C)
+
+/*
+ * Measurement provider interface.
+ *
+ * Implementors hand REAL samples to the REGI2C device (e.g. values captured
+ * on hardware during the same calibration flow). Without a linked provider
+ * every data-producing operation in esp32s3.regi2c fails closed: the device
+ * never presents DONE-with-data, reports the exact unavailable dependency
+ * and pauses the VM. All methods return true + *out when a real sample is
+ * available; false means "not available" (device fails closed).
+ */
+#define TYPE_ESP32S3_REGI2C_MEAS_PROVIDER "esp32s3-regi2c-meas-provider"
+typedef struct Esp32s3RegI2cMeasProviderInterface Esp32s3RegI2cMeasProviderInterface;
+DECLARE_CLASS_CHECKERS(Esp32s3RegI2cMeasProviderInterface,
+                       ESP32S3_REGI2C_MEAS_PROVIDER,
+                       TYPE_ESP32S3_REGI2C_MEAS_PROVIDER)
+
+struct Esp32s3RegI2cMeasProviderInterface {
+    ObjectClass parent;
+
+    /* SAR2/PWDT result FIFO word (13-bit code) for conversion @cycle,
+     * FIFO index @word (+0x80 + 4*word). */
+    bool (*sar2_word)(DeviceState *dev, uint32_t cycle, unsigned word,
+                      uint32_t *value);
+    /* Temperature sensor raw count [7:0] (SENS_SAR_TCTRL tsens_out). */
+    bool (*tsens_sample)(DeviceState *dev, uint32_t *value);
+    /* Analog I2C slave read-data byte ([23:16] of the transaction word). */
+    bool (*engine_read_byte)(DeviceState *dev, uint8_t slave, uint8_t reg,
+                             uint8_t *value);
+    /* Analog-side operation completion + flags (op ids in _defs.h). */
+    bool (*op_done)(DeviceState *dev, unsigned op, uint32_t arg);
+};
+
+typedef enum Esp32s3RegI2CSar2Phase {
+    REGI2C_SAR2_IDLE = 0,
+    REGI2C_SAR2_CMD,     /* config transaction on the modeled I2C bus */
+    REGI2C_SAR2_SAMPLING /* 8 SAR2 conversions filling the result FIFO */
+} Esp32s3RegI2CSar2Phase;
+
+typedef struct Esp32s3RegI2CEngine {
+    QEMUTimer *timer;
+    struct ESP32S3RegI2CState *parent;
+    int index;
+} Esp32s3RegI2CEngine;
+
+struct ESP32S3RegI2CState {
+    SysBusDevice parent_obj;
+
+    /* 0x6000E000 .. 0x6000E0FF (undocumented REGI2C / I2C_MST block) */
+    MemoryRegion iomem;
+    /* 0x60008830 .. 0x60008837 (SENS_SAR_MEAS2_CTRL2 / _MUX force pair).
+     * INTEGRATION: moves under the single SENS owner once the full SENS
+     * controller lands; this device then consumes the agreed GPIO inputs
+     * (contract with the ADC lane). */
+    MemoryRegion sens_iomem;
+    /* 0x60008850 .. 0x60008853 (SENS_SAR_TCTRL, temperature sensor) */
+    MemoryRegion tctrl_iomem;
+
+    Esp32s3RegI2CEngine eng[2];
+    QEMUTimer *sar2_timer;
+    QEMUTimer *txdc_timer;
+    QEMUTimer *tsens_timer;
+    QEMUBH *pause_bh;
+
+    /* Measurement provider (optional; absent => fail closed). */
+    DeviceState *meas_provider;
+    bool unavailable; /* a dependency failure was reported this run */
+
+    /* Word-indexed register file, see esp32s3_regi2c_defs.h */
+    uint32_t regs[ESP32S3_REGI2C_REG_SIZE / 4];
+
+    /* Analog I2C slave register file (config storage). The ROM grammar is
+     * read-modify-write everywhere (rom_chip_i2c_readReg_org /
+     * rom_i2c_readReg_Mask consumers), so reads must return prior writes;
+     * reset defaults are UNKNOWN and modeled as 0. Measurement surfaces
+     * (SAR2 FIFO, TSENS OUT, TX-DC flags) are NOT part of this file -- they
+     * stay fail-closed behind the measurement provider. */
+    uint8_t slave_regs[REGI2C_SLAVE_COUNT][REGI2C_SLAVE_REGS];
+    uint8_t slave_written[REGI2C_SLAVE_COUNT][REGI2C_SLAVE_REGS / 8];
+
+    /* SENS SAR2 force registers (evidenced offsets only) */
+    uint32_t sens_ctrl2; /* SENS_SAR_MEAS2_CTRL2_REG 0x60008830 */
+    uint32_t sens_mux;   /* SENS_SAR_MEAS2_MUX_REG   0x60008834 */
+    uint32_t sens_tctrl; /* SENS_SAR_TCTRL_REG (sar_tctrl) 0x60008850 */
+
+    /* SAR2/PWDET sequencer bookkeeping (virtual clock) */
+    uint32_t sar2_conv_count;
+    uint8_t sar2_phase; /* Esp32s3RegI2CSar2Phase */
+};
+
+#endif /* HW_MISC_ESP32S3_REGI2C_H */
diff --git a/include/hw/misc/esp32s3_regi2c_defs.h b/include/hw/misc/esp32s3_regi2c_defs.h
new file mode 100644
index 0000000..f8767b0
--- /dev/null
+++ b/include/hw/misc/esp32s3_regi2c_defs.h
@@ -0,0 +1,109 @@
+/*
+ * ESP32-S3 REGI2C / I2C_MST analog master register definitions
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Offsets 0x00/0x04/0x40/0x44/0x48 carry public IDF names for parts of
+ * their fields (components/soc/esp32s3/include/soc/regi2c_defs.h). The
+ * remaining offsets have NO public S3 names; they are named here after
+ * their evidenced role, with the source function cited per field. All
+ * semantics marked UNKNOWN are intentionally stored/read-back only.
+ */
+#ifndef HW_MISC_ESP32S3_REGI2C_DEFS_H
+#define HW_MISC_ESP32S3_REGI2C_DEFS_H
+
+#include "qemu/bitops.h"
+#include "hw/registerfields.h"
+
+#define ESP32S3_REGI2C_REG_SIZE 0x100
+
+/* Parallel engine transaction words (rom_i2c_paral_write 0x40035684 /
+ * rom_i2c_paral_read 0x40035614 / rom_chip_i2c_readReg_org 0x400354fc) */
+#define A_REGI2C_ENG0_WORD   0x00
+#define A_REGI2C_ENG1_WORD   0x04
+#define REGI2C_ENG_SLAVE     0x000000ffu /* [7:0] slave address */
+#define REGI2C_ENG_REG       0x0000ff00u /* [15:8] slave register */
+#define REGI2C_ENG_DATA      0x00ff0000u /* [23:16] write data / read result */
+#define REGI2C_ENG_START     BIT(24)     /* write/start flag (reads omit it) */
+#define REGI2C_ENG_BUSY      BIT(25)     /* RO, self-clearing */
+#define REGI2C_ENG_FUNC_MASK 0x0c000000u /* [27:26] func id (ROM uses 1) */
+FIELD(REGI2C_ENG, FUNC, 26, 2)
+
+/* Public regi2c_defs.h names */
+#define A_REGI2C_ANA_CONF0   0x40 /* I2C_MST_ANA_CONF0_REG (BBPLL bits) */
+#define A_REGI2C_ANA_CONFIG  0x44 /* ANA_CONFIG_REG (slave enable mask) */
+#define A_REGI2C_ANA_CONFIG2 0x48 /* ANA_CONFIG2_REG (mst0 select) */
+
+/* SAR2/PWDET sequencer status + control (no public name; rom_pkdet_vol_start
+ * 0x40036a18 polls [26:24] == 7 and toggles BIT1 between two polls) */
+#define A_REGI2C_SAR2_STATUS    0x50
+#define REGI2C_SAR2_STATUS_MASK 0x07000000u
+#define REGI2C_SAR2_STATUS_IDLE (7u << 24)
+
+/* Master bring-up config words (rom_i2cmst_reg_init 0x400389f0) */
+#define A_REGI2C_MST_CFG0    0x54 /* ROM writes 0x0f0f into [15:0] */
+#define A_REGI2C_MST_CFG1    0x58 /* ROM writes 100 into [7:0], 0xff into
+                                   * [23:16]; role of [7:0] modeled as the
+                                   * I2C SCL divider (semantics UNKNOWN) */
+FIELD(REGI2C_MST_CFG1, DIV, 0, 8)
+
+/* TX DC calibration status/command (no public name; blob txdc_cal_v70 in
+ * libphy.a: RMW keeps [31:24], commands 0x113cf1/0x113cf3 into [20:0],
+ * then polls BIT24 (bnone at 0x42013ead); BIT30/BIT31 steer the search
+ * direction -- semantics UNKNOWN) */
+#define A_REGI2C_TXDC_STATUS   0x4c
+#define REGI2C_TXDC_CMD_START  BIT(0)    /* both observed commands set it */
+#define REGI2C_TXDC_DONE       BIT(24)   /* RO, self-setting after the
+                                          * modeled operation time */
+#define REGI2C_TXDC_FLAG30     BIT(30)   /* UNKNOWN */
+
+/* SAR2/PWDET config (rom_pwdet_sar2_init 0x40036470 /
+ * rom_pkdet_vol_start / rom_get_sar2_vol 0x40036afc) */
+#define A_REGI2C_SAR2_CFG       0x5c /* [7:0] slave (0x6a), [15:8] reg,
+                                      * BIT19 mode (UNKNOWN), BIT23 start */
+#define REGI2C_SAR2_CFG_START   BIT(23)
+#define A_REGI2C_SAR2_CFG2      0x60 /* BIT5 (pwdet_sar2_init clears),
+                                      * [4:3] attenuation select
+                                      * (rom_get_sar2_vol), other bits
+                                      * stored (UNKNOWN) */
+
+/* SAR2/PWDET result window: 8 consecutive 13-bit codes
+ * (rom_read_sar_dout 0x40036aa4 reads +0x80..+0x9c) */
+#define A_REGI2C_SAR2_DATA0     0x80
+
+/* Stored config word (rom_i2cmst_reg_init sets bits 30, 24, 22, 17,
+ * clears 29; semantics UNKNOWN) */
+#define A_REGI2C_UNK_CFG        0xc4
+
+/* SENS SAR2 force bits (sens_reg.h) */
+#define SENS_SAR_MEAS2_CTRL2_EN_PAD_FORCE BIT(31) /* 0x60008830 */
+#define SENS_SAR_MEAS2_MUX_RTC_FORCE      BIT(31) /* 0x60008834 */
+
+/* SENS_SAR_TCTRL (sar_tctrl, 0x60008854) TSENS fields (sens_struct.h,
+ * esp_hal_ana_conv/esp32s3 temperature_sensor_ll.h contract: SW sets
+ * TSENS_DUMP_OUT, polls TSENS_READY, reads TSENS_OUT) */
+#define SENS_TSENS_OUT        0x000000ffu /* [7:0] RO data */
+#define SENS_TSENS_READY      BIT(8)      /* [8] RO ready */
+#define SENS_TSENS_CLK_DIV    0x003fc000u /* [21:14] divider */
+FIELD(SENS_TSENS, CLK_DIV, 14, 8)
+#define SENS_TSENS_POWER_UP   BIT(22)
+#define SENS_TSENS_DUMP_OUT   BIT(24)
+/* Modeled TSENS conversion: 32 cycles of a 1 MHz tsens clock scaled by the
+ * evidenced clk_div field (base clock UNKNOWN; bounded choice). */
+#define REGI2C_TSENS_CLK_HZ   1000000ull
+#define REGI2C_TSENS_CYCLES   32u
+
+/* Measurement-provider op ids (Esp32s3RegI2cMeasProviderInterface::op_done) */
+#define REGI2C_OP_TXDC  1u /* TX-DC calibration op (+0x4c) */
+
+/* Engine word field accessors */
+#define REGI2C_ENG_SLAVE_OF(w) ((uint8_t)((w) & 0xffu))
+#define REGI2C_ENG_REG_OF(w)   ((uint8_t)(((w) >> 8) & 0xffu))
+#define REGI2C_ENG_BYTE0(w)    ((w) & 0xffu)
+#define REGI2C_ENG_DATA_OF(w)  ((uint8_t)(((w) >> 16) & 0xffu))
+
+/* Analog I2C slave register file geometry (7-bit slaves, 8-bit regs) */
+#define REGI2C_SLAVE_COUNT 128u
+#define REGI2C_SLAVE_REGS  256u
+
+#endif /* HW_MISC_ESP32S3_REGI2C_DEFS_H */
