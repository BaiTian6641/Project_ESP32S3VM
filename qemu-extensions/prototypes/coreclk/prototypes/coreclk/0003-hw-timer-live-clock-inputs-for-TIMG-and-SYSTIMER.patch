+/**
+ * Recompute the rates of the running counters after the clock tree or a
+ * SYSTEM PERIP_CLK_EN0 gate changed.
+ *
+ * Mirrors the ordering of esp_t0_config_update: a running counter is first
+ * advanced at its old rate (the accumulated tick count is preserved across
+ * the frequency change), then the new rate applies and the pending alarm is
+ * reprogrammed for the new rate. A gated group freezes its counters: the
+ * alarm is disarmed while gated and resumes with the remaining ticks once
+ * the gate reopens.
+ */
+static void esp_timg_refresh_clocks(ESPTimgState *s)
+{
+    /* Tx timers */
+    ESPT0State *timers[2] = { &s->t0, &s->t1 };
+    for (int i = 0; i < 2; ++i) {
+        ESPT0State *t = timers[i];
+        const bool enabled = FIELD_EX32(t->config, TIMG_T0CONFIG, EN);
+        const uint64_t new_freq = esp_timg_timer_freq(s, t);
+
+        if (enabled) {
+            /* Advance the counter at the old rate before changing it */
+            esp_t0_update_counter(t);
+        }
+        t->counter.frequency = new_freq;
+        if (!enabled) {
+            continue;
+        }
+        if (!new_freq || !FIELD_EX32(t->config, TIMG_T0CONFIG, ALARM_EN)) {
+            timer_del(&t->counter.timer);
+        } else {
+            esp_t0_alarm_update(t);
+        }
+    }
+
+    /* MWDT */
+    {
+        ESPWdtState *wdt = &s->wdt;
+        const bool enabled = esp_wdt_enabled(wdt);
+        const uint64_t new_freq =
+            esp_wdt_ext_clk_frequency(s) / wdt->prescaler;
+
+        if (enabled) {
+            /* Accumulate the ticks elapsed at the old rate */
+            esp_virtual_counter_update(&wdt->counter);
+        }
+        wdt->counter.frequency = new_freq;
+        if (!enabled) {
+            return;
+        }
+        if (!new_freq) {
+            timer_del(&wdt->counter.timer);
+        } else {
+            /* Resume the current stage from the already-counted ticks */
+            const int64_t remaining =
+                (int64_t)wdt->stage[wdt->current_stage] - (int64_t)wdt->counter.value;
+            if (remaining <= 0) {
+                esp_wdt_cb(wdt);
+            } else {
+                esp_virtual_counter_resume_in_ticks(&wdt->counter, remaining);
+            }
+        }
+    }
+}
+
+static void esp_timg_clk_gate(void *opaque, int n, int level)
+{
+    ESPTimgState *s = ESP_TIMG(opaque);
+    const bool on = level != 0;
+
+    if (n == 0) {
+        if (s->timers_clk_on == on) {
+            return;
+        }
+        s->timers_clk_on = on;
+    } else {
+        if (s->wdt_clk_on == on) {
+            return;
+        }
+        s->wdt_clk_on = on;
+    }
+    esp_timg_refresh_clocks(s);
+}
+
+static void esp_timg_apb_clk_update(void *opaque, ClockEvent event)
+{
+    if (event == ClockUpdate) {
+        esp_timg_refresh_clocks(ESP_TIMG(opaque));
+    }
+}
+
+static void esp_timg_xtal_clk_update(void *opaque, ClockEvent event)
+{
+    if (event == ClockUpdate) {
+        esp_timg_refresh_clocks(ESP_TIMG(opaque));
+    }
+}
