+/* Live clock frequencies (Hz).
+ *
+ * When the SoC connected the clock inputs (ESP_TIMG_APB_CLK_IN /
+ * ESP_TIMG_XTAL_CLK_IN) the rates come from the propagated clock tree, so
+ * divider/source changes in the SYSTEM registers alter the progress of the
+ * modeled timers. The compile-time ESP_APB_CLK/ESP_XTAL_CLK constants are the
+ * fallback for machines without clock wiring (classic ESP32).
+ * @clk_on carries the SYSTEM PERIP_CLK_EN0 gate: a gated group makes no
+ * progress. */
+static inline uint64_t esp_timg_apb_freq(ESPTimgState *s, bool clk_on)
+{
+    if (!clk_on) {
+        return 0;
+    }
+    return clock_has_source(s->apb_clk) ? clock_get_hz(s->apb_clk) : ESP_APB_CLK;
+}
+
+static inline uint64_t esp_timg_xtal_freq(ESPTimgState *s, bool clk_on)
+{
+    if (!clk_on) {
+        return 0;
+    }
+    return clock_has_source(s->xtal_clk) ? clock_get_hz(s->xtal_clk) : ESP_XTAL_CLK;
+}
+
+/* Time-base clock of a Tx timer: source (TIMG_TxCONFIG USE_XTAL selects
+ * XTAL_CLK or APB_CLK, TRM v1.8 ch.12 §12.2) divided by the 16-bit prescaler */
+static uint64_t esp_timg_timer_freq(ESPTimgState *s, const ESPT0State *t)
+{
+    const uint32_t divider = FIELD_EX32(t->config, TIMG_T0CONFIG, DIVIDER);
+    const uint64_t clk = FIELD_EX32(t->config, TIMG_T0CONFIG, USE_XTAL) ?
+                         esp_timg_xtal_freq(s, s->timers_clk_on) :
+                         esp_timg_apb_freq(s, s->timers_clk_on);
+    return divider ? clk / divider : 0;
+}
