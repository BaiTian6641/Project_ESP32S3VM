@@ -411,6 +414,12 @@ static const MemoryRegionOps esp_aes_ops = {
 static void esp_aes_reset_hold(Object *obj, ResetType type)
 {
     ESPAesState *s = ESP_AES(obj);
+
+    /* PERIPH reset domain: CPU-only resets keep the AES engine state */
+    if (s->soc_reset && !esp32s3_reset_covers_periph(s->soc_reset)) {
+        return;
