diff --git a/hw/char/esp32_uart.c b/hw/char/esp32_uart.c
index 41de9cf..a421d6d 100644
--- a/hw/char/esp32_uart.c
+++ b/hw/char/esp32_uart.c
@@ -23,6 +23,7 @@
 #include "hw/qdev-properties.h"
 #include "hw/qdev-properties-system.h"
 #include "hw/char/esp32_uart.h"
+#include "hw/xtensa/esp32s3_reset_domain.h"
 #include "trace.h"
 
 
@@ -313,6 +314,11 @@ static void esp32_uart_reset_hold(Object *obj, ResetType type)
 {
     ESP32UARTState *s = ESP32_UART(obj);
 
+    /* PERIPH reset domain: CPU-only resets keep the UART registers and FIFOs */
+    if (s->soc_reset && !esp32s3_reset_covers_periph(s->soc_reset)) {
+        return;
+    }
+
     memset(s->reg, 0, sizeof(s->reg));
     s->reg[R_UART_RXD_CNT] = 0;
     s->reg[R_UART_INT_ST] = 0;
@@ -372,6 +378,7 @@ static void esp32_uart_init(Object *obj)
 
 static Property esp32_uart_properties[] = {
     DEFINE_PROP_CHR("chardev", ESP32UARTState, chr),
+    DEFINE_PROP_LINK("soc-reset", ESP32UARTState, soc_reset, TYPE_DEVICE, DeviceState *),
     DEFINE_PROP_END_OF_LIST(),
 };
 
