+        uint32_t status[ESP32S3_INTMATRIX_STATUS_WORDS] = { 0 };
+        /* INTR_STATUS_0..3 cover the documented sources only (TRM Table
+         * 9.3-1: word 3 carries the last 3 sources); inputs beyond
+         * ETS_MAX_INTR_SOURCE have no status bit and no routing. */
+        for (int src = 0; src < ETS_MAX_INTR_SOURCE; ++src) {
