     {
         sysbus_realize(SYS_BUS_DEVICE(&ss->timg[0]), &error_fatal);
         MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ss->timg[0]), 0);
@@ -872,7 +1082,6 @@ static void esp32s3_machine_init(MachineState *machine)
