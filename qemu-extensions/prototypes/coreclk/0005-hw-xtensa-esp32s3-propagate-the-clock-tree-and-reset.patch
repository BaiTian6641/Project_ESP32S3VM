+            qdev_connect_clock_in(DEVICE(&ss->timg[i]), ESP_TIMG_XTAL_CLK_IN,
+                                  qdev_get_clock_out(clk_dev, "xtal-clk"));
+        }
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_GATES_GPIO,
+                                    ESP32S3_GATE_TIMG0_TIMERS,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->timg[0]),
+                                                           ESP_TIMG_CLK_GATE_IN, 0));
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_GATES_GPIO,
+                                    ESP32S3_GATE_TIMG0_WDT,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->timg[0]),
+                                                           ESP_TIMG_CLK_GATE_IN, 1));
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_GATES_GPIO,
+                                    ESP32S3_GATE_TIMG1_TIMERS,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->timg[1]),
+                                                           ESP_TIMG_CLK_GATE_IN, 0));
+        qdev_connect_gpio_out_named(clk_dev, ESP32S3_CLK_GATES_GPIO,
+                                    ESP32S3_GATE_TIMG1_WDT,
+                                    qdev_get_gpio_in_named(DEVICE(&ss->timg[1]),
+                                                           ESP_TIMG_CLK_GATE_IN, 1));
+    }
+    {
