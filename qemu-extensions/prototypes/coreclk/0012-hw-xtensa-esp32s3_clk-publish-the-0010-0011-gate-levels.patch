From 0c1d83216f0c9e5cd3f1366651bda253d43e8577 Mon Sep 17 00:00:00 2001
From: ESP32S3VM coreclk <coreclk@esp32s3vm.invalid>
Date: Wed, 7 Oct 2026 15:21:53 +0800
Subject: [PATCH] hw/xtensa/esp32s3_clk: publish the 0010/0011 gate levels

Fixes an omission in the 0010/0011 commits: the gate enumerations and
bundle lines existed, but esp32s3_clock_update_gates() still drove only
the four TIMG aggregations, so the SPI2/SPI3/I2C0/I2C1/RMT/I2S0/I2S1/
UART0/UART1/UART2/UHCI0 gate lines never propagated the SYSTEM
PERIP_CLK_EN0/1 bits. Found by the I2S overlay lane source-read.
---
 hw/xtensa/esp32s3_clk.c | 35 ++++++++++++++++++++++++++++++-----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/hw/xtensa/esp32s3_clk.c b/hw/xtensa/esp32s3_clk.c
index 8e724c4..26ae388 100644
--- a/hw/xtensa/esp32s3_clk.c
+++ b/hw/xtensa/esp32s3_clk.c
@@ -110,16 +110,41 @@ void esp32s3_clk_set_rtc_clocks(ESP32S3ClockState *s, uint32_t rtc_slow_hz,
  * equations on Esp32s3PeriphClkGate). */
 static void esp32s3_clock_update_gates(ESP32S3ClockState *s)
 {
-    const bool timers = s->perip_clk_en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERS_CLK_EN_MASK;
-    const bool wdg = s->perip_clk_en0 & R_SYSTEM_PERIP_CLK_EN0_WDG_CLK_EN_MASK;
-    const bool tg0 = s->perip_clk_en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERGROUP_CLK_EN_MASK;
-    const bool tg1 = s->perip_clk_en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERGROUP1_CLK_EN_MASK;
+    const uint32_t en0 = s->perip_clk_en0;
+    const bool timers = en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERS_CLK_EN_MASK;
+    const bool wdg = en0 & R_SYSTEM_PERIP_CLK_EN0_WDG_CLK_EN_MASK;
+    const bool tg0 = en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERGROUP_CLK_EN_MASK;
+    const bool tg1 = en0 & R_SYSTEM_PERIP_CLK_EN0_TIMERGROUP1_CLK_EN_MASK;
 
-    
     qemu_set_irq(s->gate_irqs[ESP32S3_GATE_TIMG0_TIMERS], timers && tg0);
     qemu_set_irq(s->gate_irqs[ESP32S3_GATE_TIMG0_WDT], wdg && tg0);
     qemu_set_irq(s->gate_irqs[ESP32S3_GATE_TIMG1_TIMERS], timers && tg1);
     qemu_set_irq(s->gate_irqs[ESP32S3_GATE_TIMG1_WDT], wdg && tg1);
+
+    /* Common clock port extensions (0010/0012): single-bit gates for the
+     * peripheral overlay lanes */
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_SPI2],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_SPI2_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_SPI3],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_SPI3_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_I2C0],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_EXT0_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_I2C1],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_EXT1_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_RMT],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_RMT_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_I2S0],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_I2S0_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_I2S1],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_I2S1_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_UART0],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_UART_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_UART1],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_UART1_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_UART2],
+                 s->perip_clk_en1 & R_SYSTEM_PERIP_CLK_EN1_UART2_CLK_EN_MASK);
+    qemu_set_irq(s->gate_irqs[ESP32S3_GATE_UHCI0],
+                 en0 & R_SYSTEM_PERIP_CLK_EN0_UHCI0_CLK_EN_MASK);
 }
 
 /* Mirror the raw SYSTEM_PERIP_RST_EN0/1 levels per Esp32s3PeriphRstReq index
-- 
2.43.0

