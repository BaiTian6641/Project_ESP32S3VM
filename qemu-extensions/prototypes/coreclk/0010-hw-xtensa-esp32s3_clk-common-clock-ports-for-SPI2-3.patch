From bee7698b00ac3fe65050d1fdf84bfe84e69d6a89 Mon Sep 17 00:00:00 2001
From: ESP32S3VM coreclk <coreclk@esp32s3vm.invalid>
Date: Wed, 7 Oct 2026 15:13:49 +0800
Subject: [PATCH] hw/xtensa/esp32s3_clk: common clock ports for SPI2/3, I2C,
 RMT, I2S, UART
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Centralized additive ports consumed by the peripheral overlay lanes
(published contract in qemu-extensions/prototypes/coreclk/README.md):

- New Clock outputs on the SYSTEM device: pll-f80m-clk / pll-f160m-clk /
  pll-f240m-clk (PLL-derived module clocks, TRM v1.8 ch.7 7.2.4.2: F160M
  and F80M divide the running PLL to constant 160/80 MHz, F240M exists
  only on the 480 MHz PLL; all 0 Hz while the SoC clock is not PLL) and
  rc-fast-clk (standalone RC_FAST oscillator, 17.5 MHz nominal, valid per
  the RTC_CNTL CK8M power bits — independent of the RTC_FAST mux).

- SYSTEM_PERIP_CLK_EN0/1 gate levels and SYSTEM_PERIP_RST_EN0/1 strobe +
  level bundles extended to SPI2 [6], SPI3 [16], I2C_EXT0 [7], I2C_EXT1
  [18], RMT [9], I2S0 [4], I2S1 [21], UART [2], UART1 [5], UART2 (EN1
  [9]). New per-index bundle periph-rst-level mirrors the raw reset bits
  for consumers with level-held reset semantics (SPI full reset, I2C
  write blocking); the previous bundles keep their meaning.

- RTC_CNTL stores the CK8M_FORCE_PD [25] / FORCE_PU [26] power bits and
  derives the RC_FAST validity; the SoC propagates it on every clock
  update without touching the RTC_FAST selection.
---
 hw/misc/esp32s3_rtc_cntl.c         |  9 +++
 hw/xtensa/esp32s3.c                |  2 +
 hw/xtensa/esp32s3_clk.c            | 98 ++++++++++++++++++++++++++++++
 include/hw/misc/esp32s3_rtc_cntl.h |  7 +++
 include/hw/xtensa/esp32s3_clk.h    | 45 +++++++++++++-
 tests/qtest/esp32s3-coreclk-test.c | 25 ++++++++
 6 files changed, 185 insertions(+), 1 deletion(-)

diff --git a/hw/misc/esp32s3_rtc_cntl.c b/hw/misc/esp32s3_rtc_cntl.c
index 165d91f..f2ce3ce 100644
--- a/hw/misc/esp32s3_rtc_cntl.c
+++ b/hw/misc/esp32s3_rtc_cntl.c
@@ -85,6 +85,7 @@ static uint64_t esp32s3_rtc_cntl_read(void *opaque, hwaddr addr, unsigned int si
         r = FIELD_DP32(r, RTC_CNTL_CLK_CONF, SOC_CLK_SEL, s->soc_clk);
         r = FIELD_DP32(r, RTC_CNTL_CLK_CONF, FAST_CLK_RTC_SEL, s->rtc_fastclk);
         r = FIELD_DP32(r, RTC_CNTL_CLK_CONF, ANA_CLK_RTC_SEL, s->rtc_slowclk);
+        r = FIELD_DP32(r, RTC_CNTL_CLK_CONF, CK8M_FORCE_PD, !s->rc_fast_powered);
         break;
 
     case A_RTC_CNTL_SW_CPU_STALL:
@@ -153,6 +154,13 @@ static void esp32s3_rtc_cntl_write(void *opaque, hwaddr addr, uint64_t value,
         s->soc_clk = FIELD_EX32(value, RTC_CNTL_CLK_CONF, SOC_CLK_SEL);
         s->rtc_fastclk = FIELD_EX32(value, RTC_CNTL_CLK_CONF, FAST_CLK_RTC_SEL);
         s->rtc_slowclk = FIELD_EX32(value, RTC_CNTL_CLK_CONF, ANA_CLK_RTC_SEL);
+        /* RC_FAST (CK8M) oscillator power: RTC_CNTL_CK8M_FORCE_PD [25] /
+         * CK8M_FORCE_PU [26] (IDF6.1 rtc_cntl_reg.h; both reset 0 = powered).
+         * Only the force-power-down state gates the oscillator here; the
+         * SoC propagates the validity on the standalone rc-fast-clk output.
+         * Bits 16..24 (FORCE_NOGATING, DFREQ) are stored implicitly as 0. */
+        s->rc_fast_powered =
+            !(value & R_RTC_CNTL_CLK_CONF_CK8M_FORCE_PD_MASK);
         esp32s3_rtc_update_clk(s);
         break;
 
@@ -257,6 +265,7 @@ static void esp32s3_rtc_cntl_init(Object *obj)
         s->stat_vector_sel[i] = true;
     }
 
+    s->rc_fast_powered = true;   /* CK8M_FORCE_PD resets to 0 = powered */
     s->rtc_slowclk = ESP32_SLOW_CLK_RC;
     /* Register reset default: FAST_CLK_RTC_SEL = 0 (XTAL/2),
      * IDF6.1 soc/esp32s3/register/soc/rtc_cntl_reg.h "default: 1'b0". */
diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
index 64bee30..ccfd901 100644
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -295,6 +295,8 @@ static void esp32s3_soc_update_clocks(Esp32s3SocState *s)
     esp32s3_clk_set_rtc_clocks(&s->clock,
                                s->rtc_cntl.rtc_slowclk_freq,
                                s->rtc_cntl.rtc_fastclk_freq);
+    /* Standalone RC_FAST oscillator validity (RTC_CNTL CK8M power bits) */
+    esp32s3_clk_set_rc_fast(&s->clock, s->rtc_cntl.rc_fast_powered);
 }
 
 static void esp32s3_clk_update(void* opaque, int n, int level)
diff --git a/hw/xtensa/esp32s3_clk.c b/hw/xtensa/esp32s3_clk.c
index 7525bcd..d6f4b2f 100644
--- a/hw/xtensa/esp32s3_clk.c
+++ b/hw/xtensa/esp32s3_clk.c
@@ -81,6 +81,22 @@ void esp32s3_clk_recompute_system(ESP32S3ClockState *s)
     /* APB_CLK: 80 MHz from PLL_CLK, otherwise equal to CPU_CLK */
     clock_update_hz(s->out_apb,
                     soc_clk_sel == ESP32S3_CLK_SEL_PLL ? 80000000 : cpu_hz);
+
+    /* PLL-derived module clocks (TRM v1.8 ch.7 §7.2.4.2): they only run
+     * while the BBPLL is selected. F160M divides the PLL to a constant
+     * 160 MHz (PLL480/3, PLL320/2); F80M divides to a constant 80 MHz
+     * (PLL480/6, PLL320/4); F240M only exists on the 480 MHz PLL (/2). */
+    const bool pll_on = soc_clk_sel == ESP32S3_CLK_SEL_PLL;
+    clock_update_hz(s->out_pll_f80m, pll_on ? 80000000u : 0);
+    clock_update_hz(s->out_pll_f160m, pll_on ? 160000000u : 0);
+    clock_update_hz(s->out_pll_f240m,
+                    pll_on && pll_freq_sel == ESP32S3_FREQ_SEL_PLL_480 ?
+                    240000000u : 0);
+}
+
+void esp32s3_clk_set_rc_fast(ESP32S3ClockState *s, bool powered)
+{
+    clock_update_hz(s->out_rc_fast, powered ? ESP32S3_CLK_RC_FAST_HZ : 0);
 }
 
 void esp32s3_clk_set_rtc_clocks(ESP32S3ClockState *s, uint32_t rtc_slow_hz,
@@ -106,6 +122,58 @@ static void esp32s3_clock_update_gates(ESP32S3ClockState *s)
     qemu_set_irq(s->gate_irqs[ESP32S3_GATE_TIMG1_WDT], wdg && tg1);
 }
 
+/* Mirror the raw SYSTEM_PERIP_RST_EN0/1 levels per Esp32s3PeriphRstReq index
+ * (1 = held in reset) for consumers with level-held reset semantics. */
+static void esp32s3_clock_update_rst_levels(ESP32S3ClockState *s)
+{
+    const uint32_t en0 = s->perip_rst_en0, en1 = s->perip_rst_en1;
+
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_TIMG0],
+                 (en0 & (R_SYSTEM_PERIP_RST_EN0_TIMERGROUP_RST_MASK |
+                         R_SYSTEM_PERIP_RST_EN0_TIMERS_RST_MASK)) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_TIMG1],
+                 (en0 & (R_SYSTEM_PERIP_RST_EN0_TIMERGROUP1_RST_MASK |
+                         R_SYSTEM_PERIP_RST_EN0_TIMERS_RST_MASK)) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_SYSTIMER],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_SYSTIMER_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_SPI1],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_SPI01_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_UART0],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_UART_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_UART1],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_UART1_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_TWAI],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_CAN_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_SPI2],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_SPI2_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_SPI3],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_SPI3_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_I2C0],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_EXT0_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_I2C1],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_EXT1_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_RMT],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_RMT_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_I2S0],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_I2S0_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_I2S1],
+                 (en0 & R_SYSTEM_PERIP_RST_EN0_I2S1_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_GDMA],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_DMA_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_UART2],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_UART2_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_AES],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_AES_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_SHA],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_SHA_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_RSA],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_RSA_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_DS],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_DS_RST_MASK) != 0);
+    qemu_set_irq(s->rst_level_irqs[ESP32S3_RST_HMAC],
+                 (en1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_HMAC_RST_MASK) != 0);
+}
+
 /* Pulse the reset strobes matching a 0 -> 1 transition of the modeled
  * SYSTEM_PERIP_RST_EN0/1 bits. The SoC turns a strobe into a cold reset of the
  * corresponding modeled device. */
@@ -157,6 +225,27 @@ static void esp32s3_clock_strobe_rst(ESP32S3ClockState *s, uint32_t risen0,
     if (risen1 & R_SYSTEM_PERIP_RST_EN1_CRYPTO_HMAC_RST_MASK) {
         qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_HMAC]);
     }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_SPI2_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_SPI2]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_SPI3_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_SPI3]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_EXT0_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_I2C0]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_EXT1_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_I2C1]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_RMT_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_RMT]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_I2S0_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_I2S0]);
+    }
+    if (risen0 & R_SYSTEM_PERIP_RST_EN0_I2S1_RST_MASK) {
+        qemu_irq_pulse(s->rst_irqs[ESP32S3_RST_I2S1]);
+    }
 }
 
 static uint32_t esp32s3_read_cpu_intr(ESP32S3ClockState *s, uint32_t index)
@@ -262,12 +351,14 @@ static void esp32s3_clock_write(void *opaque, hwaddr addr, uint64_t value,
         case A_SYSTEM_PERIP_RST_EN0: {
             const uint32_t former = s->perip_rst_en0;
             s->perip_rst_en0 = (uint32_t)value;
+            esp32s3_clock_update_rst_levels(s);
             esp32s3_clock_strobe_rst(s, (uint32_t)value & ~former, 0);
             break;
         }
         case A_SYSTEM_PERIP_RST_EN1: {
             const uint32_t former = s->perip_rst_en1;
             s->perip_rst_en1 = (uint32_t)value;
+            esp32s3_clock_update_rst_levels(s);
             esp32s3_clock_strobe_rst(s, 0, (uint32_t)value & ~former);
             break;
         }
@@ -343,6 +434,7 @@ static void esp32s3_clock_reset_hold(Object *obj, ResetType type)
                        R_SYSTEM_PERIP_CLK_EN1_USB_DEVICE_CLK_EN_MASK;
     s->perip_rst_en0 = 0;
     s->perip_rst_en1 = 0;
+    esp32s3_clock_update_rst_levels(s);
     esp32s3_clock_update_gates(s);
 
     /* Propagate the reset clock tree. The RTC_SLOW/RTC_FAST outputs get the
@@ -375,12 +467,18 @@ static void esp32s3_clock_init(Object *obj)
     s->out_xtal = qdev_init_clock_out(DEVICE(obj), "xtal-clk");
     s->out_rtc_slow = qdev_init_clock_out(DEVICE(obj), "rtc-slow-clk");
     s->out_rtc_fast = qdev_init_clock_out(DEVICE(obj), "rtc-fast-clk");
+    s->out_pll_f80m = qdev_init_clock_out(DEVICE(obj), "pll-f80m-clk");
+    s->out_pll_f160m = qdev_init_clock_out(DEVICE(obj), "pll-f160m-clk");
+    s->out_pll_f240m = qdev_init_clock_out(DEVICE(obj), "pll-f240m-clk");
+    s->out_rc_fast = qdev_init_clock_out(DEVICE(obj), "rc-fast-clk");
 
     /* Aggregated peripheral clock gate levels and reset strobes */
     qdev_init_gpio_out_named(DEVICE(obj), s->gate_irqs, ESP32S3_CLK_GATES_GPIO,
                              ESP32S3_GATE_COUNT);
     qdev_init_gpio_out_named(DEVICE(obj), s->rst_irqs, ESP32S3_CLK_RST_GPIO,
                              ESP32S3_RST_COUNT);
+    qdev_init_gpio_out_named(DEVICE(obj), s->rst_level_irqs,
+                             ESP32S3_CLK_RST_LEVEL_GPIO, ESP32S3_RST_COUNT);
 
     /* Initialize the output IRQ lines used to manually trigger interrupts */
     for (uint64_t i = 0; i < ESP32S3_SYSTEM_CPU_INTR_COUNT; i++) {
diff --git a/include/hw/misc/esp32s3_rtc_cntl.h b/include/hw/misc/esp32s3_rtc_cntl.h
index 5dbb1f3..83f6361 100644
--- a/include/hw/misc/esp32s3_rtc_cntl.h
+++ b/include/hw/misc/esp32s3_rtc_cntl.h
@@ -87,6 +87,11 @@ typedef struct Esp32s3RtcCntlState {
     uint32_t rtc_fastclk_freq;
     Esp32s3SlowClkSel rtc_slowclk;
     uint32_t rtc_slowclk_freq;
+    /* RC_FAST (CK8M) oscillator power state from RTC_CNTL_CLK_CONF
+     * CK8M_FORCE_PD [25] / CK8M_FORCE_PU [26] (IDF6.1 rtc_cntl_reg.h):
+     * powered unless force-power-down is set. Drives the standalone
+     * rc-fast-clk output validity. */
+    bool rc_fast_powered;
     int64_t time_base_ns;
 
     uint32_t options0_reg;
@@ -125,6 +130,8 @@ REG32(RTC_CNTL_CLK_CONF, 0x74)
     FIELD(RTC_CNTL_CLK_CONF, ANA_CLK_RTC_SEL, 30, 2)
     FIELD(RTC_CNTL_CLK_CONF, FAST_CLK_RTC_SEL, 29, 1)
     FIELD(RTC_CNTL_CLK_CONF, SOC_CLK_SEL, 27, 2)
+    FIELD(RTC_CNTL_CLK_CONF, CK8M_FORCE_PD, 25, 1)
+    FIELD(RTC_CNTL_CLK_CONF, CK8M_FORCE_PU, 26, 1)
 
 REG32(RTC_CNTL_SW_CPU_STALL, 0xbc)
     FIELD(RTC_CNTL_SW_CPU_STALL, PROCPU_C1, 26, 6)
diff --git a/include/hw/xtensa/esp32s3_clk.h b/include/hw/xtensa/esp32s3_clk.h
index 588b9af..8bb9391 100644
--- a/include/hw/xtensa/esp32s3_clk.h
+++ b/include/hw/xtensa/esp32s3_clk.h
@@ -33,6 +33,11 @@
  */
 #define ESP32S3_CLK_GATES_GPIO      "periph-clk-gate"
 #define ESP32S3_CLK_RST_GPIO        "periph-rst-req"
+/* Level bundle mirroring the raw SYSTEM_PERIP_RST_EN0/1 bit per index
+ * (1 = peripheral held in reset). Consumers that need level-held reset
+ * semantics (block register writes while asserted) connect this instead of
+ * the rising-edge strobe bundle. */
+#define ESP32S3_CLK_RST_LEVEL_GPIO  "periph-rst-level"
 
 /**
  * Aggregated gate lines driven from SYSTEM_PERIP_CLK_EN0/1 and consumed by the
@@ -47,6 +52,17 @@ enum Esp32s3PeriphClkGate {
     ESP32S3_GATE_TIMG0_WDT,
     ESP32S3_GATE_TIMG1_TIMERS,
     ESP32S3_GATE_TIMG1_WDT,
+    /* Common clock port extensions (0010): SPI2/3, I2C0/1, RMT, I2S0/1 */
+    ESP32S3_GATE_SPI2,          /* SYSTEM_PERIP_CLK_EN0: SPI2_CLK_EN [6]     */
+    ESP32S3_GATE_SPI3,          /* SYSTEM_PERIP_CLK_EN0: SPI3_CLK_EN [16]    */
+    ESP32S3_GATE_I2C0,          /* SYSTEM_PERIP_CLK_EN0: I2C_EXT0 [7]        */
+    ESP32S3_GATE_I2C1,          /* SYSTEM_PERIP_CLK_EN0: I2C_EXT1 [18]       */
+    ESP32S3_GATE_RMT,           /* SYSTEM_PERIP_CLK_EN0: RMT_CLK_EN [9]      */
+    ESP32S3_GATE_I2S0,          /* SYSTEM_PERIP_CLK_EN0: I2S0_CLK_EN [4]     */
+    ESP32S3_GATE_I2S1,          /* SYSTEM_PERIP_CLK_EN0: I2S1_CLK_EN [21]    */
+    ESP32S3_GATE_UART0,         /* SYSTEM_PERIP_CLK_EN0: UART_CLK_EN [2]     */
+    ESP32S3_GATE_UART1,         /* SYSTEM_PERIP_CLK_EN0: UART1_CLK_EN [5]    */
+    ESP32S3_GATE_UART2,         /* SYSTEM_PERIP_CLK_EN1: UART2_CLK_EN [9]    */
     ESP32S3_GATE_COUNT
 };
 
@@ -70,6 +86,14 @@ enum Esp32s3PeriphRstReq {
     ESP32S3_RST_RSA,        /* CRYPTO_RSA_RST (EN1 [3])               */
     ESP32S3_RST_DS,         /* CRYPTO_DS_RST (EN1 [4])                */
     ESP32S3_RST_HMAC,       /* CRYPTO_HMAC_RST (EN1 [5])              */
+    /* Common clock port extensions (0010): SPI2/3, I2C0/1, RMT, I2S0/1 */
+    ESP32S3_RST_SPI2,       /* SPI2_RST [6]                           */
+    ESP32S3_RST_SPI3,       /* SPI3_RST [16]                          */
+    ESP32S3_RST_I2C0,       /* I2C_EXT0_RST [7]                       */
+    ESP32S3_RST_I2C1,       /* I2C_EXT1_RST [18]                      */
+    ESP32S3_RST_RMT,        /* RMT_RST [9]                            */
+    ESP32S3_RST_I2S0,       /* I2S0_RST [4]                           */
+    ESP32S3_RST_I2S1,       /* I2S1_RST [21]                          */
     ESP32S3_RST_COUNT
 };
 
@@ -109,6 +133,14 @@ typedef struct ESP32S3ClockState {
     Clock *out_xtal;        /* XTAL_CLK (SYSTIMER CNT_CLK and RTC_FAST input) */
     Clock *out_rtc_slow;    /* RTC_SLOW_CLK                                   */
     Clock *out_rtc_fast;    /* RTC_FAST_CLK                                   */
+    /* Common clock port extensions (0010): independent PLL-derived module
+     * clocks and the standalone RC_FAST oscillator (not the RTC_FAST mux
+     * selection). */
+    Clock *out_pll_f80m;    /* PLL_F80M_CLK: 80 MHz when the PLL is on        */
+    Clock *out_pll_f160m;   /* PLL_F160M_CLK: 160 MHz when the PLL is on      */
+    Clock *out_pll_f240m;   /* PLL_F240M_CLK: 240 MHz from the 480 MHz PLL    */
+    Clock *out_rc_fast;     /* RC_FAST_CLK: 17.5 MHz oscillator, valid per
+                             * RTC_CNTL CK8M power bits (esp32s3_clk_set_rc_fast) */
 
     /* SYSTEM_PERIP_CLK_EN0/1 and SYSTEM_PERIP_RST_EN0/1 (TRM v1.8 ch.17,
      * Registers 17.4 to 17.7). Reset values per the IDF6.1 field defaults. */
@@ -117,9 +149,11 @@ typedef struct ESP32S3ClockState {
     uint32_t perip_rst_en0;
     uint32_t perip_rst_en1;
 
-    /* Aggregated gate levels (1 = enabled) and reset strobes */
+    /* Aggregated gate levels (1 = enabled), reset strobes (pulse on a
+     * 0->1 PERIP_RST edge) and reset levels (1 = PERIP_RST bit set) */
     qemu_irq gate_irqs[ESP32S3_GATE_COUNT];
     qemu_irq rst_irqs[ESP32S3_RST_COUNT];
+    qemu_irq rst_level_irqs[ESP32S3_RST_COUNT];
 
     /* ESP32-S3 SoC, used to gate the hold phase by reset domain */
     DeviceState *soc_reset;
@@ -157,3 +191,12 @@ void esp32s3_clk_recompute_system(ESP32S3ClockState *s);
 void esp32s3_clk_set_rtc_clocks(ESP32S3ClockState *s, uint32_t rtc_slow_hz,
                                 uint32_t rtc_fast_hz);
 
+/**
+ * Drive the standalone RC_FAST_CLK output ("rc-fast-clk", 17.5 MHz nominal)
+ * according to the RTC_CNTL CK8M power bits (RTC_CNTL_CK8M_FORCE_PD [25] /
+ * FORCE_PU [26], TRM v1.8 ch.10): @powered false propagates 0 Hz. RC_FAST is
+ * an independent oscillator — its validity does not follow the RTC_FAST mux
+ * selection.
+ */
+void esp32s3_clk_set_rc_fast(ESP32S3ClockState *s, bool powered);
+
diff --git a/tests/qtest/esp32s3-coreclk-test.c b/tests/qtest/esp32s3-coreclk-test.c
index 751ace1..0c9e414 100644
