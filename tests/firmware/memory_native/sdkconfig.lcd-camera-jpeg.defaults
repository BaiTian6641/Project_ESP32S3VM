# Combine LCD base + this mode + sdkconfig.lcd-cam-quad.defaults, in that order.
CONFIG_LCD_CAM_NATIVE_CAMERA=y
CONFIG_LCD_CAM_NATIVE_CAM_JPEG=y
CONFIG_LCD_CAM_NATIVE_FB_COUNT=2
CONFIG_LCD_CAM_NATIVE_SLOW_MS=0
CONFIG_LCD_CAM_NATIVE_FAULT=0
CONFIG_CAMERA_PSRAM_DMA=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768
# CONFIG_CAMERA_CONVERTER_ENABLED is not set
# QQVGA native JPEG source upper bound270512; capacity is a whole1024-byte node multiple.
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_CUSTOM=y
# CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE_AUTO is not set
CONFIG_CAMERA_JPEG_MODE_FRAME_SIZE=278528
# Use actual esp_jpeg1.3.1 software decoder, not an unqualified ROM JPEG hook.
# CONFIG_JD_USE_ROM is not set
CONFIG_JD_FORMAT_RGB888=y
CONFIG_JD_FASTDECODE_BASIC=y
# CONFIG_JD_FASTDECODE_32BIT is not set
# CONFIG_JD_FASTDECODE_TABLE is not set
CONFIG_JD_SZBUF=512
CONFIG_JD_USE_SCALE=y
CONFIG_JD_TBLCLIP=y
# CONFIG_JD_DEFAULT_HUFFMAN is not set
