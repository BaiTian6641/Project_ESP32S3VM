# Combine LCD base + this mode + sdkconfig.lcd-cam-quad.defaults, in that order.
CONFIG_LCD_CAM_NATIVE_CAMERA=y
CONFIG_LCD_CAM_NATIVE_CAM_RGB565=y
CONFIG_LCD_CAM_NATIVE_FB_COUNT=2
CONFIG_LCD_CAM_NATIVE_SLOW_MS=0
CONFIG_LCD_CAM_NATIVE_FAULT=0
CONFIG_CAMERA_PSRAM_DMA=y
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768
# CONFIG_CAMERA_CONVERTER_ENABLED is not set
